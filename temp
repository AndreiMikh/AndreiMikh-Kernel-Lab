# Disable BakaSU Git-Based Source Updates
  if [[ "${ROOTENGINE:-}" == "BakaSU" && -n "${ROOTCOMMIT:-}" ]]; then
  echo "└─ 🔒 [Info] Disabling BakaSU Git Updates..."
    sed -i \
      -e '/git stash && echo/d' \
      -e '/git pull && echo/d' \
      -e '/git checkout main && echo/d' \
      -e '/git checkout "\$1" && echo/d' \
      "$setupscript"
  fi
