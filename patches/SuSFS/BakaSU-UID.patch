+else ifeq ($(shell grep -F -q 'val = (val << 4 | (val >> (8*sizeof(unsigned int)-4))) ^ (*p)' $(srctree)/security/selinux/ss/symtab.c; echo $$?),0)
+ccflags-y += -DKSU_COMPAT_SYMTAB_HASH_ROT4
+endif
