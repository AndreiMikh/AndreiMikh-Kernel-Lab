diff --git a/kernel/Kconfig b/kernel/Kconfig
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -246,2 +246,10 @@ config KSU_SUSFS_SUS_MAP
 
+config KSU_SUSFS_PRIORITY_UID_FILTER
+    bool "Enable SUSFS priority UID filter"
+    depends on KSU_SUSFS
+    default y
+    help
+        Hide configured application UIDs from getpriority, setpriority,
+        ioprio_get, and ioprio_set for unprivileged app processes.
+
 endmenu
diff --git a/kernel/manager/throne_tracker.c b/kernel/manager/throne_tracker.c
--- a/kernel/manager/throne_tracker.c
+++ b/kernel/manager/throne_tracker.c
@@ -13,2 +13,5 @@
 #include <linux/kernel.h> // for container_of in UL
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
+#include <linux/susfs.h>
+#endif
 
@@ -362,2 +365,6 @@ out:
     revert_creds(old_cred);
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
+    // Refresh after tracking completes, including deferred scans.
+    susfs_parse_priority_app_strings();
+#endif
 }
diff --git a/kernel/supercall/dispatch.c b/kernel/supercall/dispatch.c
--- a/kernel/supercall/dispatch.c
+++ b/kernel/supercall/dispatch.c
@@ -11,2 +11,3 @@
 #ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
 #include <linux/susfs_def.h>
@@ -1170,2 +1171,8 @@ int ksu_handle_susfs_cmd(unsigned int cmd, void __user **arg)
 #endif // #ifdef CONFIG_KSU_SUSFS_SUS_MAP
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
+    case CMD_SUSFS_SET_PRIORITY_UID_FILTER: {
+        susfs_set_priority_uid_filter(arg);
+        return 0;
+    }
+#endif // CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
     case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING: {
