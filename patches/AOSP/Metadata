      - name: ⚙️ Configure Kernel Build Metadata
        shell: bash
        env:
          KERNELSUFFIX: ${{ inputs.KERNELSUFFIX }}
          KERNELBUILDTIME: ${{ inputs.KERNELBUILDTIME }}
        run: |
          # Configure Kernel Local Version
          echo "└─ 🔧 Configuring Kernel Local Version..."
          if [[ -n "$KERNELSUFFIX" ]]; then
            LOCALVERSION="-${KERNELSUFFIX}-4k"
          else
            LOCALVERSION="-${SRCCOMMIT}-4k"
          fi

          # Resolve Build Timestamp Input
          TIMEINPUT="$KERNELBUILDTIME"
          if [[ -n "$TIMEINPUT" ]]; then
            DATESTR="$TIMEINPUT"
            echo "└─ 🔎 Using Custom Build Time : $DATESTR"
          else
            DATESTR="$(TZ='UTC' date '+%a %b %-d %H:%M:%S UTC %Y')"
            echo "└─ 🛠️ Using Current UTC Time  : $DATESTR"
          fi

          # Validate Build Timestamp Format
          if ! date -d "$DATESTR" >/dev/null 2>&1; then
            echo "└─ ⚠️ Invalid Build Time"
            echo "└─ 📌 Value                   : $DATESTR"
            echo "└─ 📌 Expected                : <Day> <Month> <DD> <HH:MM:SS> UTC <YYYY>"
            exit 1
          fi

          # Configure Kbuild Build Metadata
          export KBUILD_BUILD_TIMESTAMP="$DATESTR"
          export KBUILD_BUILD_VERSION="1"
          # Export Build Metadata To Following Workflow Steps
          {
            echo "LOCALVERSION=$LOCALVERSION"
            echo "KBUILD_BUILD_TIMESTAMP=$KBUILD_BUILD_TIMESTAMP"
            echo "KBUILD_BUILD_VERSION=$KBUILD_BUILD_VERSION"
          } >> "$GITHUB_ENV"
          # Display Final Configuration
          echo "└─ 🔎 Final Kernel Local Version : $LOCALVERSION"
          echo "└─ 🔍 Kbuild Build Metadata"
          echo "└─ 📌 Build Timestamp             : $KBUILD_BUILD_TIMESTAMP"
          echo "└─ 📌 Build Version               : $KBUILD_BUILD_VERSION"
          echo "└─ 📌 Android Base                : $ANDROIDVERSION"
          echo "└─ 📌 Kernel Base                 : $KERNELVERSION"
          echo "└─ 📌 Kernel Version              : $FULLVERSION"
          # Validate Build Metadata
          if [[ -z "${KBUILD_BUILD_TIMESTAMP:-}" ]]; then
            echo "└─ ⚠️ Kbuild Build Timestamp Not Set"
            exit 1
          fi

          if [[ -z "${KBUILD_BUILD_VERSION:-}" ]]; then
            echo "└─ ⚠️ Kbuild Build Version Not Set"
            exit 1
          fi

          echo "└─ 🎉 Kernel Build Metadata Configured"
