KERNEL_VERSION: 6.6
  SUBLEVEL: ${{ github.event.inputs.SUBLEVEL }}
  CCACHE_DIR: ${{ github.workspace }}/ccache

# ==============================
      # Package Public Compiler Cache
      # ==============================
      - name: Package Public Compiler Cache
        if: ${{ github.event.inputs.BUILD_NOCCACHE != 'true' }}
        run: |
          set -Eeuo pipefail

          echo "------------------------------"
          echo "📦 Public Compiler Cache Pack"
          echo "------------------------------"

          CCACHE_PATH="${CCACHE_DIR}"
          FILE_NAME="ccache-${KERNEL_VERSION}.${SUBLEVEL}.tar.zst"

          echo "Cache dir : $CCACHE_PATH"
          echo "File name : $FILE_NAME"

          if [[ ! -d "$CCACHE_PATH" ]]; then
            echo "No ccache directory, skipping"
            exit 0
          fi

          if [[ -z "$(ls -A "$CCACHE_PATH")" ]]; then
            echo "Empty ccache, skipping"
            exit 0
          fi

          tar -I zstd -cf "$FILE_NAME" -C "$CCACHE_PATH" .

          echo "Created $FILE_NAME"
          echo "------------------------------"

# ==============================
      # Upload Public Compiler Cache
      # ==============================
      - name: Upload Public Compiler Cache
        if: ${{ github.event.inputs.BUILD_NOCCACHE != 'true' }}
        uses: actions/upload-artifact@v3
        with:
          name: ccache-${{ env.KERNEL_VERSION }}.${{ env.SUBLEVEL }}
          path: ccache-${{ env.KERNEL_VERSION }}.${{ env.SUBLEVEL }}.tar.zst
