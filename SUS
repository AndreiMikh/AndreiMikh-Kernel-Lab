      # ==============================
      # SUSFS Patches (Auto Official / Fallback) ZRAM and Kernel Compatibility Patches
      # ==============================
      - name: 🔧 SUSFS Patches (Auto Official / Fallback) ZRAM and Kernel Compatibility Patches
        if: ${{ github.event.inputs.SUSFSREPOSITORY != '-1' }}
        env:
          ROOTENGINE: ${{ github.event.inputs.ROOTENGINE }}
          ZRAMVALUE: ${{ github.event.inputs.ZRAMALGORITHM }}
          ZRAMCUSTOMPATCH: ${{ github.event.inputs.ZRAMCUSTOMPATCH }}
          SUSFSREPOSITORY: ${{ github.event.inputs.SUSFSREPOSITORY }}
          SUSFSVARIANT: ${{ github.event.inputs.SUSFSVARIANT }}
          SUSFSBRANCHDEV: ${{ github.event.inputs.SUSFSBRANCHDEV }}
          FILE: ${{ github.event.inputs.FILE }}
          NTSYNC: ${{ github.event.inputs.NTSYNC }}
          ANDROIDVERSION: ${{ env.ANDROIDVERSION }}
          KERNELVERSION: ${{ env.KERNELVERSION }}
          XUS: ${{ env.XUS }}
        run: |
          set -euo pipefail
      
          echo "------------------------------"
          echo "SUSFS Meta Patch Installation..."
          echo "------------------------------"
          echo ""

          # Build derived variables in bash (NOT GitHub expressions)
          GKIVERSION="${ANDROIDVERSION}-${KERNELVERSION}"
          ROOTENGINE="${ROOTENGINE}"
          SUSFSREPOSITORY="${SUSFSREPOSITORY}"
          SUSFSVARIANT="${SUSFSVARIANT}"

          # Navigate to Kernel Directory
          cd kernel_workspace

          # Clone Required Patch Repositories
          echo "📥 Cloning Dependencies..."
          git clone --depth=1 https://github.com/SukiSU-Ultra/SukiSU_patch.git || true
          git clone --depth=1 https://github.com/AndreiMikh/AndreiMikh-Kernel-Lab.git || true

          echo "✔️ Patch Repositories Cloned"
          echo

          # Environment Information
          echo "🧾 Android Version : $ANDROIDVERSION"
          echo "🧾 Kernel Version  : $KERNELVERSION"
          echo "🔎 Detected Kernel Base: $GKIVERSION"
          echo
         
          echo "🔎 Detected Kernel Base: $GKIVERSION"
      
          # Detect Kernel Common Directory
          if [[ -d "./kernel_platform/common" ]]; then
              KDIR="./kernel_platform/common"
          elif [[ -d "./common" ]]; then
              KDIR="./common"
          else
              echo "⚠️ ERROR: Kernel Common Directory Not Found!"
              exit 1
          fi
      
          echo "📁 Kernel Directory: $KDIR"
          echo
      
          # Clone SUSFS Meta Repository
          echo "📥 Cloning SUSFS..."
      
          BRANCH="gki-${ANDROIDVERSION}-${KERNELVERSION}"
      
          if [[ "$SUSFSVARIANT" == "OGKI" ]]; then
            BRANCH="oki-${ANDROIDVERSION}-${KERNELVERSION}"
            if [[ "$SUSFSBRANCHDEV" == "true" ]]; then
              BRANCH="${BRANCH}-dev"
            fi
            git clone --depth=1 https://github.com/cctv18/susfs4oki.git susfs4ksu -b "$BRANCH"
          else
            if [[ "$SUSFSBRANCHDEV" == "true" ]]; then
              BRANCH="${BRANCH}-dev"
            fi
            git clone --depth=1 https://gitlab.com/simonpunk/susfs4ksu.git susfs4ksu -b "$BRANCH"
          fi
      
          echo "✔️ SUSFS Branch: $BRANCH"
      
          # Optional SUSFS Meta Commit Checkout
          cd susfs4ksu || exit 1
      
          if [[ -n "$SUSFSREPOSITORY" ]]; then
            echo "🔎 SUSFS Revision: $SUSFSREPOSITORY"
      
            if [[ "$SUSFSREPOSITORY" =~ ^[0-9]+$ ]]; then
              git checkout "HEAD~$SUSFSREPOSITORY" || true
            else
              git checkout "$SUSFSREPOSITORY" || true
            fi
          fi
      
          cd ..
      
          # Find SUSFS Patches
          echo "🔎 Searching SUSFS Patches..."
      
          shopt -s nullglob
          SUSFSPATCHLIST=(./susfs4ksu/kernel_patches/50_add_susfs_in_gki-${ANDROIDVERSION}-${KERNELVERSION}*.patch)
      
          if [[ ${#SUSFSPATCHLIST[@]} -eq 0 ]]; then
            echo "⚠️ No SUSFS Patch Found"
            ls ./susfs4ksu/kernel_patches/ || true
            exit 1
          fi
      
          SUSFSPATCH="${SUSFSPATCHLIST[-1]}"
      
          echo "🧾 Using Patch: $SUSFSPATCH"
      
          cp "$SUSFSPATCH" "$KDIR/"
          cp -r ./susfs4ksu/kernel_patches/fs/* "$KDIR/fs/" || true
          cp -r ./susfs4ksu/kernel_patches/include/linux/* "$KDIR/include/linux/" || true

          cd "$KDIR"

          # TrustyOS Missing Fix (6.6)     
          # Only Run if SUSFS is Enabled
          if [[ "$SUSFSREPOSITORY" != "-1" ]]; then

            # Only Apply for 6.6.x Kernel Series
            if [[ "$KERNELVERSION" == 6.6* ]]; then
              echo "🔧 Checking TrustyOS Requirement for Kernel 6.6.x..."

              TRUSTYEXISTS=false

              # Use Manifest Produced by Extract Manifest Step
              MANIFESTFILE="$GITHUB_WORKSPACE/.repo/manifests_fallback/${FILE}.xml"

              # Fallback (Sync Case)
              if [[ ! -s "$MANIFESTFILE" ]]; then
                MANIFESTFILE="$GITHUB_WORKSPACE/.repo/manifest.xml"
              fi

              # Detect Trusty Module in Manifest
              if [[ -f "$MANIFESTFILE" ]] && grep -q "common-modules/trusty" "$MANIFESTFILE"; then
                TRUSTYEXISTS=true
              fi

              # Apply Fix Only if Trusty is Missing          
              if [[ "$TRUSTYEXISTS" == "false" ]]; then
                echo "🛠 Applying TrustyOS Compatibility Fix (GKI 6.6)"
                PATCHNAME="$(basename "${SUSFSPATCH:-}")"
                if [[ -f "$PATCHNAME" ]]; then

                 # Patch Adjustments
                  sed -i \
                    's/-32,12 +32,38/-32,11 +32,37/g' \
                    "$PATCHNAME"
                  sed -i \
                    '/#include <trace\/hooks\/fs.h>/d' \
                    "$PATCHNAME"
                  echo "✔ TrustyOS Patch Adjusted"
                else
                  echo "⚠️ SUSFS Patch File Not Found, Skipping Trusty fix"
                fi
              else
                echo "✔ TrustyOS Already Present in Manifest, Skipping Fix"
              fi
            fi
          fi
                    
          # SUSFS Meta Fake Patch Workaround
          if [[ "$SUSFSREPOSITORY" != "-1" ]]; then          
            FAKEPATCHED=0          
            # Android 15 Kernel 6.6 Fix
            if [[ "$GKIVERSION" == "android15-6.6" ]]; then          
              if ! grep -qxF $'\tunsigned int nr_subpages = __PAGE_SIZE / PAGE_SIZE;' ./fs/proc/task_mmu.c; then
                echo "⚠️ Missing NR Subpages Fix 🛠️ Applying Temporary Patch"          
                sed -i \
                  -e '/int ret = 0, copied = 0;/a \\tunsigned int nr_subpages \= __PAGE_SIZE \/ PAGE_SIZE;' \
                  -e '/int ret = 0, copied = 0;/a \\tpagemap_entry_t \*res = NULL;' \
                  ./fs/proc/task_mmu.c          
                FAKEPATCHED=1
              fi
          
              if ! grep -qxF '#include <linux/dma-buf.h>' ./fs/proc/base.c; then
                echo "📩 Adding Missing DMA-BUF Header"          
                sed -i '/#include <linux\/cpufreq_times.h>/a #include <linux\/dma-buf.h>' ./fs/proc/base.c
              fi
            fi
                    
            # Android 14 Kernel 6.1 Fix
            if [[ "$GKIVERSION" == "android14-6.1" ]]; then          
              if ! grep -qxF $'\tif (!vma_pages(vma))' ./fs/proc/task_mmu.c; then
                echo "🛠️ Missing VMA Pages Fix"
                FAKEPATCHED=1
              fi
          
              if ! grep -qxF '#include <linux/dma-buf.h>' ./fs/proc/base.c; then
                echo "📩 Adding DMA-BUF Header"          
                sed -i '/#include <linux\/cpufreq_times.h>/a #include <linux\/dma-buf.h>' ./fs/proc/base.c
              fi
            fi          
          
            # Android 12 / 13 Fix
            if [[ "$GKIVERSION" == "android12-5.10" || "$GKIVERSION" == "android13-5.15" ]]; then          
              if ! grep -qxF $'\tif (!vma_pages(vma))' ./fs/proc/task_mmu.c; then
                echo "🛠️ Missing VMA Pages Fix"
                FAKEPATCHED=1
              fi
            fi  

            # SUSFS Core Patch (50 Add SUSFS Patch)
            echo "⚙️ Applying SUSFS Core Patch (50 Add SUSFS Patch)"
            patch -p1 < "$(basename "$SUSFSPATCH")" || exit 1
          
            # SUSFS 69 Enable Hide Patch
            PATCH69URL="https://raw.githubusercontent.com/AndreiMikh/AndreiMikh-Kernel-Lab/LiquidAndrei/patches/69_hide_stuff.patch"
            PATCH69FILE="hide.patch"

            SUPPORTEDOGKI() {
              case "$GKIVERSION" in
                android14-6.1|android15-6.1|android15-6.6) return 0 ;;
                *) return 1 ;;
              esac
            }

            SUPPORTEDENGINE() {
              [[ "$SUSFSVARIANT" == "OGKI" ]] || \
              [[ "$ROOTENGINE" == "SukiSU-Ultra" ]] || \
              [[ "$ROOTENGINE" == "ReSukiSU" ]]
            }

            if SUPPORTEDOGKI && SUPPORTEDENGINE; then

              echo "⚙️ Applying SUSFS 69 Enable Hide Patch to $ROOTENGINE..."

              if ! wget -q "$PATCH69URL" -O "$PATCH69FILE"; then
                echo "⚠️ Failed to Download SUSFS 69 Enable Hide Patch"
                exit 1
              fi

              if patch -p1 -N -F 3 < "$PATCH69FILE"; then
                echo "🔧 SUSFS 69 Enable Hide Patch Applied"
              else
                echo "⚠️ SUSFS 69 Enabled Hide Patch Not Applied (Already Applied or Failed)"
              fi

              rm -f "$PATCH69FILE"
              
            else
              echo "⚠️ SUSFS 69 Enable Hide Patch Skipped (Unsupported Base)"
            fi

            # SUSFS 10 Enable Patch for KernelSU (Only for KernelSU)
            if [[ "$ROOTENGINE" == "KernelSU" ]]; then

              echo "⚙️ Applying KernelSU SUSFS enable patch"

              if [[ "$SUSFSVARIANT" == "OGKI" ]]; then
                PATCHBRANCH="oki-${ANDROIDVERSION}-${KERNELVERSION}"
              else
                PATCHBRANCH="gki-${ANDROIDVERSION}-${KERNELVERSION}"
              fi

              [[ "${SUSFSBRANCHDEV}" == "true" ]] && PATCHBRANCH="${PATCHBRANCH}-dev"

              case "$SUSFSVARIANT" in
                GKI)
                  SUSFS10URL="https://gitlab.com/simonpunk/susfs4ksu/-/raw/${PATCHBRANCH}/kernel_patches/${ROOTENGINE}/10_enable_susfs_for_ksu.patch"
                  ;;
                OGKI)
                  SUSFS10URL="https://raw.githubusercontent.com/cctv18/susfs4oki/${PATCHBRANCH}/kernel_patches/${ROOTENGINE}/10_enable_susfs_for_ksu.patch"
                  ;;
                *)
                  echo "⚠️ Invalid SUSFS Variant"
                  exit 1
                  ;;
              esac

              echo "🌐 Downloading Patch: $SUSFS10URL"

              if ! wget -q "$SUSFS10URL" -O enable.patch; then
                echo "⚠️ ERROR: Failed to Download SUSFS Enable Patch"
                exit 1
              fi

              APPLIED=false

              for pathprefix in 0 1 2; do
                if patch -p$pathprefix < enable.patch; then
                  APPLIED=true
                  break
                fi
              done

              rm -f enable.patch

              if [[ "$APPLIED" != "true" ]]; then
                echo "⚠️ ERROR: Failed to Apply SUSFS Enable Patch at Any Path Prefix Level"
                exit 1
              else
                echo "✔️ SUSFS Enable Patch Applied Successfully"
              fi
            else
              echo "⚠️ Skipping KernelSU SUSFS Enable Patch (Root = $ROOTENGINE Not Compatible)"
            fi
            
            # Revert Temporary Fake Patch
            if [[ "$FAKEPATCHED" == 1 ]]; then          
              echo "♻️ Reverting Temporary Fake Patch"          
              if [[ "$GKIVERSION" == "android15-6.6" ]]; then          
                if grep -qxF $'\tunsigned int nr_subpages = __PAGE_SIZE / PAGE_SIZE;' ./fs/proc/task_mmu.c; then
                  sed -i \
                    -e '/unsigned int nr_subpages \= __PAGE_SIZE \/ PAGE_SIZE;/d' \
                    -e '/pagemap_entry_t \*res = NULL;/d' \
                    ./fs/proc/task_mmu.c
                fi
              fi
          
              if [[ "$GKIVERSION" == "android12-5.10" || \
                    "$GKIVERSION" == "android13-5.15" || \
                    "$GKIVERSION" == "android14-6.1" ]]; then          
                if grep -qxF $'\t\t\tgoto show_pad;' ./fs/proc/task_mmu.c; then
                  sed -i 's/goto show_pad;/return 0;/' ./fs/proc/task_mmu.c
                fi
              fi
            fi

            echo ""
            echo "🎉 SUSFS Patches Complete"
           
            # Check if ZRAM or LZ4 is Enabled
            if [[ "$ZRAMVALUE" == 1* || \
                  "$ZRAMCUSTOMPATCH" == "LZ4-1.10.0-Patch" || \
                  "$ZRAMCUSTOMPATCH" == "LZ4-1.10.0+LZ4KD" || \
                  "$ZRAMCUSTOMPATCH" == "LZ4-1.10.0-Custom-Patch" ]]; then
          
                echo "🔧 Starting ZRAM + LZ4 / ZSTD Patch Installation..."
                echo ""

                # Paths
                WORKSPACE="${GITHUB_WORKSPACE}/kernel_workspace"
                KDIR="${WORKSPACE}/kernel_platform"
                ZRAMPATCHBASE="${WORKSPACE}/AndreiMikh-Kernel-Lab/patches"

                EXTREPO="https://github.com/Xiaomichael/kernel_patches.git"
                EXTBRANCH="patches"
                EXTZRAMBASE="$WORKSPACE/kernel_patches"
                EXTZRAMPATCH="$EXTZRAMBASE/zram"
          
                PATCHSKIP=0
          
                if [[ ! -d "$KDIR" ]]; then
                    echo "⚠️ Kernel Platform Directory Not Found: $KDIR"
                    echo "⚠️ Skipping Entire ZRAM / LZ4 Patch Flow"
                    PATCHSKIP=1
                fi
          
                cd "$KDIR" || {
                    echo "⚠️ Cannot Enter Kernel Directory — Skipping"
                    PATCHSKIP=1
                }
          
                applysukisuzram() {
                    echo "🚀 Applying SukiSU ZRAM Patches..."
          
                    local src="${WORKSPACE}/SukiSU_patch/other/zram"
                    local dst="./common"
          
                    echo "📂 Source : $src"
                    echo "📂 Target : $dst"
          
                    mkdir -p \
                        "$dst/include/linux" \
                        "$dst/lib" \
                        "$dst/crypto" \
                        "$dst/lib/lz4k_oplus"
          
                    cp -r "$src/lz4k/include/linux/." "$dst/include/linux/" 2>/dev/null || \
                        echo "⚠️ Failed Copying Include/Linux"
          
                    cp -r "$src/lz4k/lib/." "$dst/lib/" 2>/dev/null || \
                        echo "⚠️ Failed Copying Lib"
          
                    cp -r "$src/lz4k/crypto/." "$dst/crypto/" 2>/dev/null || \
                        echo "⚠️ Failed Copying Crypto"
          
                    cp -r "$src/lz4k_oplus/." "$dst/lib/lz4k_oplus/" 2>/dev/null || \
                        echo "⚠️ Failed Copying LZ4K OPlus"
          
                    local kconfig="$dst/lib/Kconfig"
          
                    if [[ -f "$kconfig" ]]; then
                        grep -q 'lib/lz4k_oplus/Kconfig' "$kconfig" || \
                            echo 'source "lib/lz4k_oplus/Kconfig"' >> "$kconfig"
                    else
                        echo "⚠️ Kernel Configuration Not Found — Skipping Include"
                    fi
          
                    echo "✔️ SukiSU ZRAM Patches Applied"
                }
          
                applypatch() {
                    local patch="$1"
          
                    if [[ ! -f "$patch" ]]; then
                        echo "⚠️ Missing Patch: $(basename "$patch")"
                        return 0
                    fi
          
                    if git apply --check "$patch" >/dev/null 2>&1; then
                        git apply -p1 "$patch" && \
                            echo "✔️ Applied: $(basename "$patch")" || \
                            echo "⚠️ Failed Applying: $(basename "$patch")"
                    else
                        echo "⚠️ Skipped: $(basename "$patch") (Already Applied or Conflict)"
                    fi
                }
          
                if [[ "$ZRAMVALUE" == 1* ]]; then
                    applysukisuzram
                else
                    echo "⚠️ ZRAM Disabled — Skipping SukiSU ZRAM Patch"
                fi
          
                cd "$WORKSPACE" || {
                    echo "⚠️ Cannot Return to Workspace"
                    PATCHSKIP=1
                }
          
                KCOMMON="./kernel_platform/common"
                [[ ! -d "$KCOMMON" ]] && KCOMMON="./common"
          
                echo ""
                echo "📂 Kernel Source Directory: $KCOMMON"
          
                if [[ "$PATCHSKIP" -eq 1 ]]; then
                    echo "⚠️ Patch Flow Partially Skipped Due to Earlier Issues"
                fi
          
                # Case 1: LZ4 + ZRAM
                if [[ "$ZRAMCUSTOMPATCH" == "LZ4-1.10.0+LZ4KD" && "$ZRAMVALUE" == 1* ]]; then
          
                    echo "⚙️ Mode: LZ4 + ZRAM"
          
                    mkdir -p "$KCOMMON/lib"
          
                    [[ -f "$EXTZRAMPATCH/001-lz4.patch" ]] || \
                        echo "⚠️ LZ4 Patch Missing"
          
                    cp "$EXTZRAMPATCH/001-lz4.patch" "$KCOMMON/" 2>/dev/null
          
                    [[ -f "$EXTZRAMPATCH/002-zstd.patch" ]] && \
                        cp "$EXTZRAMPATCH/002-zstd.patch" "$KCOMMON/"
          
                    cd "$KCOMMON" || echo "⚠️ Cannot Enter Directory"
          
                    case "$KERNELVERSION" in
                        6.1*)
                            echo "🧩 Kernel 6.1 detected"
                            applypatch "001-lz4.patch"
                            [[ -f "002-zstd.patch" ]] && applypatch "002-zstd.patch"
                            ;;
                        6.6*)
                            echo "🧩 Kernel 6.6 Detected"
                            applypatch "001-lz4.patch"
                            ;;
                        *)
                            echo "⚠️ Unsupported Kernel Version: $KERNELVERSION (Skipping)"
                            ;;
                    esac
            
                    rm -f 001-lz4.patch 002-zstd.patch 2>/dev/null
                    cd - >/dev/null
          
                    echo "✔️ LZ4 + ZRAM Patch Flow Completed"
          
                # Case 2: LZ4 Custom (Optimized) Builds
                elif [[ "$ZRAMCUSTOMPATCH" == "LZ4-1.10.0-Custom-Patch" && "$ZRAMVALUE" == 0* ]]; then
          
                    echo "⚙️ Mode: LZ4 Custom (Optimized) Builds"
          
                    mkdir -p "$KCOMMON/lib"
          
                    [[ -f "$ZRAMPATCHBASE/001-lz4.patch" ]] || \
                        echo "⚠️ LZ4 Patch Missing"
          
                    cp "$ZRAMPATCHBASE/001-lz4.patch" "$KCOMMON/" 2>/dev/null
           
                    cd "$KCOMMON" || echo "⚠️ Cannot Enter Directory"
          
                    case "$KERNELVERSION" in
                        6.1*)
                            echo "🧩 Kernel 6.1 Detected"
                            applypatch "001-lz4.patch"
                            [[ -f "$ZRAMPATCHBASE/002-zstd.patch" ]] && {
                                cp "$ZRAMPATCHBASE/002-zstd.patch" .
                                applypatch "002-zstd.patch"
                            }
                            ;;
                        6.6*)
                            echo "🧩 Kernel 6.6 detected"
                            applypatch "001-lz4.patch"
                            ;;
                        *)
                            echo "⚠️ Unsupported Kernel Version: $KERNELVERSION"
                            ;;
                    esac
          
                    rm -f 001-lz4.patch 002-zstd.patch 2>/dev/null
                    cd - >/dev/null
          
                    echo "✔️ LZ4 Only Patch Flow Completed"
          
                # Case 3: LZ4 Patch 
                elif [[ "$ZRAMCUSTOMPATCH" == "LZ4-1.10.0-Patch" ]]; then
          
                    echo "⚙️ Mode: LZ4 Patch"
          
                    if git clone --depth 1 --branch "$EXTBRANCH" "$EXTREPO" "$EXTZRAMBASE"; then
                        echo "✔️ Repository Cloned"
                    else
                        echo "⚠️ Failed to Clone Patch Repository — Skipping Patches"
                    fi
          
                    mkdir -p "$KCOMMON/lib"                 
          
                    [[ -f "$EXTZRAMPATCH/001-lz4.patch" ]] && cp "$EXTZRAMPATCH/001-lz4.patch" "$KCOMMON/"
                    [[ -f "$EXTZRAMPATCH/002-zstd.patch" ]] && cp "$EXTZRAMPATCH/002-zstd.patch" "$KCOMMON/"
                    [[ -f "$EXTZRAMPATCH/lz4armv8.S" ]] && cp "$EXTZRAMPATCH/lz4armv8.S" "$KCOMMON/lib/"
          
                    cd "$KCOMMON" || echo "⚠️ Cannot Enter Directory"
          
                    case "$KERNELVERSION" in
                        6.1*)
                            applypatch "001-lz4.patch"
                            applypatch "002-zstd.patch"
                            ;;
                        6.6*)
                            applypatch "001-lz4.patch"
                            ;;
                        *)
                            echo "⚠️ Unsupported Kernel Version: $KERNELVERSION"
                            ;;
                    esac
          
                    cd - >/dev/null
          
                    echo "📂 LZ4 Patch Flow Completed"
          
                else
                    echo "⚠️ ZRAM / LZ4 Patch Disabled or Unsupported — Skipping"
                fi
          
                echo ""
                echo "🎉 ZRAM / LZ4 Patch Process Completed"
            fi
          
            # Ensure Current Directory is Defined (CI-Safe)
            CURRENTDIR="${CURRENTDIR:-$GITHUB_WORKSPACE}"
          
            # Kernel Compatibility Fixes
            KCDIR="./kernel_platform/common"
          
            if [[ ! -d "$KCDIR" ]]; then
              echo "⛔ Kernel Directory Not Found: $KCDIR"
              exit 0
            fi
          
            cd "$KCDIR" || {
              echo "⚠️ Failed to Enter Kernel Directory"
              exit 1
            }
          
            # Extract Sublevel
            SUBLEVEL=$(grep '^SUBLEVEL *=' Makefile | head -n1 | cut -d= -f2 | tr -d ' ')
          
            # Fallback if Empty
            SUBLEVEL="${SUBLEVEL:-0}"
          
            # Validate Numeric
            if ! [[ "$SUBLEVEL" =~ ^[0-9]+$ ]]; then
              echo "⚠️ Invalid Sublevel Detected: $SUBLEVEL — forcing 0"
              SUBLEVEL=0
            fi
          
            echo "📂 Kernel Base   : $GKIVERSION"
            echo "📂 Sublevel      : $SUBLEVEL"
          
            # 5.15 Legacy Fix
            if [[ "$GKIVERSION" == "android13-5.15" && "$SUBLEVEL" -lt 123 ]]; then
          
              LEGACYPATCH="$CURRENTDIR/AndreiMikh-Kernel-Lab/patches/Legacy-5.15-Fix.patch"
          
              if [[ ! -f "$LEGACYPATCH" ]]; then
                echo "⚠️ Patch Not Found: $LEGACYPATCH"
                exit 1
              fi
          
              echo "🚀 Applying Legacy Fix (Kernel 5.15.0–5.15.123)"
          
              # Check if Already Applied
              if patch -R -p1 --dry-run < "$LEGACYPATCH" >/dev/null 2>&1; then
                echo "⚠️ Patch Already Applied — Skipping"
              else
                if patch -p1 < "$LEGACYPATCH"; then
                  echo "✔️ Legacy 5.15 Fix Applied"
                else
                  echo "⚠️ Patch Failed"
                  exit 1
                fi
              fi
            fi
                                       
            # Optional XUS Fix
            if [[ "$XUS" == "Enabled" ]]; then          
              echo "🛠️ Applying XUS Fix Patch"          
              cp "$GITHUB_WORKSPACE/kernel_workspace/AndreiMikh-Kernel-Lab/patches/XUS-Fix.patch" ./
              patch -p1 < XUS-Fix.patch || true          
              echo "✔️ XUS Fix Patch Applied"
            fi

            # Primitive NTSynchronization (NTSync)
            if [[ "$NTSYNC" == "true" ]]; then
              echo "🛠️ Applying NTSync Patch..."
           
              if [[ -z "$GKIVERSION" ]]; then
                echo "💢 Kernel Base Not Set — Provide a Valid Version!"
                exit 1
              fi

              echo "🔄 Looking for NTSync Patches for Kernel: $GKIVERSION"

              # Define Patch Files and Source Directory
              NTYNCCOMPAT="ntsync_compat_${GKIVERSION}.patch"
              NTSYNCBASE="ntsync_base.patch"
              NTSYNCDIR="$GITHUB_WORKSPACE/kernel_workspace/WildKernels/common/ntsync"

              # Debug Directory Path
              echo "Github Workspace is: $GITHUB_WORKSPACE"
              echo "Looking for NTSync Patches in: $NTSYNCDIR"

              # Ensure the Directory Exists
              if [[ ! -d "$NTSYNCDIR" ]]; then
                echo "⚠️ Directory Not Found: $NTSYNCDIR"
    
                # Attempt to Clone the Repository Again if Not Found
                echo "📥 Cloning WildKernels Repository Again..."
                git clone --depth=1 https://github.com/WildKernels/kernel_patches.git "$GITHUB_WORKSPACE/kernel_workspace/WildKernels"

                # Re-check if directory exists after cloning
                if [[ ! -d "$NTSYNCDIR" ]]; then
                  echo "⚠️ Directory Still Not Found: $NTSYNCDIR"
                  exit 1
                fi
              fi

              # Log Available Patches in Source Directory
              echo "🔍 Available NTSync Patches in $NTSYNCDIR:"
              ls "$NTSYNCDIR" || {
                echo "⚠️ Failed to Fetch List of Patches in $NTSYNCDIR"
                exit 1
              }

              # Check Compat Patch File Existence and Apply
              if [[ ! -f "$NTSYNCDIR/$NTYNCCOMPAT" ]]; then
                echo "⚠️ Compat Patch Not Found for $GKIVERSION — Skipped: $NTYNCCOMPAT"
              else
                cp "$NTSYNCDIR/$NTYNCCOMPAT" ./
                echo "➡️ Applying $NTYNCCOMPAT"
                patch -p1 < "$NTYNCCOMPAT" || true
                echo "🧹 Cleaning Up Patched NTSync Compat File..."
                rm -f "$NTYNCCOMPAT"
              fi

              # Check Base Patch File Existence and Apply
              if [[ ! -f "$NTSYNCDIR/$NTSYNCBASE" ]]; then
                echo "⚠️ Base Patch Missing: $NTSYNCBASE"
              else
                cp "$NTSYNCDIR/$NTSYNCBASE" ./
                echo "➡️ Applying $NTSYNCBASE"
                patch -p1 < "$NTSYNCBASE" || true
                echo "🧹 Cleaning Up Patched NTSync Base File..."
                rm -f "$NTSYNCBASE"
              fi

              echo "✔️ NTSync Patch Step Completed"
            fi
          fi

          echo ""
          echo "🎉 Kernel Compatibility Fix Stage Completed"
