      - name: 🧾 Generate Base Kernel Configuration
        shell: bash
        run: |
          # Define Kernel Configuration Paths
          CONFIGS="$SOURCEDIR/arch/arm64/configs"
          MERGEBASECONFIGS="$SOURCEDIR/scripts/kconfig/merge_config.sh"
          echo "📥 Generating SM8750 Base Kernel Configuration..."
          echo "📂 Kernel Source : $SOURCEDIR"
          echo "📂 Config Path   : $CONFIGS"
          # Validate Config Merge Script
          if [ ! -x "$MERGEBASECONFIGS" ]; then
            echo "⚠️ Base Config Merge Script Not Found"
            echo "📂 Expected    : $MERGEBASECONFIGS"
            exit 1
          fi

          # Define Base Kernel Configurations
          BASECONFIG="$CONFIGS/gki_defconfig"
          PERFCONFIG="$CONFIGS/vendor/sun_perf.config"
          OPLUSCONFIG="$CONFIGS/vendor/oplus/sun_perf.config"
          # Validate Required Kernel Configurations
          for config in \
            "$BASECONFIG" \
            "$PERFCONFIG" \
            "$OPLUSCONFIG"; do
            if [ ! -f "$config" ]; then
              echo "⚠️ Required Kernel Config Not Found"
              echo "📂 $config"
              exit 1
            fi
          
            echo "✔️ Found : $config"
          done

          # Generate Merged Kernel Configuration
          cd "$SOURCEDIR"
          rm -f .config
          echo "🔧 Merging Base Kernel Configurations..."
          # Define Kernel Configuration File
          CONFIGFILE="$SOURCEDIR/.config"
          # Generate Merged Kernel Configuration
          KCONFIG_CONFIG="$CONFIGFILE" \
            "$MERGEBASECONFIGS" \
            -m \
            -r \
            "$BASECONFIG" \
            "$PERFCONFIG" \
            "$OPLUSCONFIG"
          # Validate Generated Configuration
          if [ ! -f "$SOURCEDIR/.config" ]; then
            echo "⚠️ Failed to Generate .config"
            exit 1
          fi

          echo "🧾 Base Kernel Config Generated"
          # Configure Kernel Local Version
          if [ -n "${{ inputs.KERNELSUFFIX }}" ]; then
            ./scripts/config \
              --file .config \
              --set-str CONFIG_LOCALVERSION "-4k-${{ inputs.KERNELSUFFIX }}"
          else
            ./scripts/config \
              --file .config \
              --set-str CONFIG_LOCALVERSION "-4k-${SRCCOMMIT}"
          fi

          # Disable Automatic Local Version Suffix
          ./scripts/config \
            --file .config \
            -d CONFIG_LOCALVERSION_AUTO
          # Display Kernel Local Version
          echo "📌 Kernel Local Version :"
          grep '^CONFIG_LOCALVERSION=' .config || true
          # Display Configuration Summary
          echo "📊 Base Configuration :"
          echo "📌 Total Options : $(grep -c '^CONFIG_' .config || true)"
          echo "🎉 Base Kernel Configuration Generated Successfully"

# Root Engine Configuration
          echo "└─ 🔧 Configuring Root Engine..."
          if [[ "$ROOTENGINE" != "None" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_KSU
            if [[ "$ROOTENGINE" == "BakaSU" ]]; then
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                --set-str CONFIG_KSU_FULL_NAME_FORMAT "%TAG_NAME%" \
                -e CONFIG_KSU_MULTI_MANAGER_SUPPORT \
                -e CONFIG_KSU_TOOLKIT_SUPPORT
              echo "└─ 📌 BakaSU Multi-Manager and Toolkit Support Configuration Enabled"
            else
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                -d CONFIG_KSU_MULTI_MANAGER_SUPPORT \
                -d CONFIG_KSU_TOOLKIT_SUPPORT
              echo "└─ 📌 BakaSU Multi-Manager and Toolkit Support Configuration Disabled"
            fi

            # SUSFS Configuration
            if [[ "$SUSFSENGINE" == "true" ]]; then
              "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_KSU_SUSFS                
              echo "└─ 📌 SUSFS Configuration Enabled"
            else
              "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_KSU_SUSFS                                
              echo "└─ 📌 SUSFS Disabled"
            fi
      
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -d CONFIG_KSU \
              -d CONFIG_KSU_MULTI_MANAGER_SUPPORT \
              -d CONFIG_KSU_TOOLKIT_SUPPORT \
              -d CONFIG_KSU_SUSFS
            echo "└─ 📌 Root Engine and SUSFS Disabled"
          fi

          # NoMount Configuration
          echo "└─ 🔧 Configuring NoMount..."
          if [[ "$NOMOUNT" != "None" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_NOMOUNT
            echo "└─ 📌 NoMount Configuration Enabled"
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_NOMOUNT
            echo "└─ 📌 NoMount Disabled"
          fi

          # BBR TCP Congestion Control
          echo "└─ 🔧 Configuring BBR..."
          if [[ "$BBR" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_TCP_CONG_BBR
            echo "└─ 📌 BBR TCP Configuration Enabled"
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_TCP_CONG_BBR
            echo "└─ 📌 BBR TCP Disabled"
          fi

          # BetterNetwork / Netfilter Configuration
          echo "└─ 🔧 Configuring BetterNetwork..."
          if [[ "$BETTERNET" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -e CONFIG_NETFILTER_XT_MATCH_ADDRTYPE \
              -e CONFIG_NETFILTER_XT_SET \
              -e CONFIG_IP_SET \
              --set-val CONFIG_IP_SET_MAX 65534 \
              -e CONFIG_IP_SET_BITMAP_IP \
              -e CONFIG_IP_SET_BITMAP_IPMAC \
              -e CONFIG_IP_SET_BITMAP_PORT \
              -e CONFIG_IP_SET_HASH_IP \
              -e CONFIG_IP_SET_HASH_IPMARK \
              -e CONFIG_IP_SET_HASH_IPPORT \
              -e CONFIG_IP_SET_HASH_IPPORTIP \
              -e CONFIG_IP_SET_HASH_IPPORTNET \
              -e CONFIG_IP_SET_HASH_IPMAC \
              -e CONFIG_IP_SET_HASH_MAC \
              -e CONFIG_IP_SET_HASH_NETPORTNET \
              -e CONFIG_IP_SET_HASH_NET \
              -e CONFIG_IP_SET_HASH_NETNET \
              -e CONFIG_IP_SET_HASH_NETPORT \
              -e CONFIG_IP_SET_HASH_NETIFACE \
              -e CONFIG_IP_SET_LIST_SET \
              -e CONFIG_IP6_NF_NAT \
              -e CONFIG_IP6_NF_TARGET_MASQUERADE \
              -e CONFIG_NETFILTER_XT_TARGET_HL \
              -e CONFIG_IP_NF_TARGET_TTL \
              -e CONFIG_IP6_NF_TARGET_HL \
              -e CONFIG_NETFILTER_XT_MATCH_HL \
              -e CONFIG_IP_NF_MATCH_TTL \
              -e CONFIG_IP6_NF_MATCH_HL \
              -e CONFIG_IP_NF_MANGLE \
              -e CONFIG_IP6_NF_MANGLE \
              -e CONFIG_BPF_STREAM_PARSER
            echo "└─ 📌 BetterNetwork Configuration Enabled"
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -d CONFIG_NETFILTER_XT_SET \
              -d CONFIG_IP_SET \
              -d CONFIG_IP_SET_BITMAP_IP \
              -d CONFIG_IP_SET_BITMAP_IPMAC \
              -d CONFIG_IP_SET_BITMAP_PORT \
              -d CONFIG_IP_SET_HASH_IP \
              -d CONFIG_IP_SET_HASH_IPMARK \
              -d CONFIG_IP_SET_HASH_IPPORT \
              -d CONFIG_IP_SET_HASH_IPPORTIP \
              -d CONFIG_IP_SET_HASH_IPPORTNET \
              -d CONFIG_IP_SET_HASH_IPMAC \
              -d CONFIG_IP_SET_HASH_MAC \
              -d CONFIG_IP_SET_HASH_NETPORTNET \
              -d CONFIG_IP_SET_HASH_NET \
              -d CONFIG_IP_SET_HASH_NETNET \
              -d CONFIG_IP_SET_HASH_NETPORT \
              -d CONFIG_IP_SET_HASH_NETIFACE \
              -d CONFIG_IP_SET_LIST_SET \
              -d CONFIG_IP6_NF_NAT \
              -d CONFIG_IP6_NF_TARGET_MASQUERADE \
              -d CONFIG_NETFILTER_XT_TARGET_HL \
              -d CONFIG_IP_NF_TARGET_TTL \
              -d CONFIG_IP6_NF_TARGET_HL \
              -d CONFIG_NETFILTER_XT_MATCH_HL \
              -d CONFIG_IP_NF_MATCH_TTL \
              -d CONFIG_IP6_NF_MATCH_HL \
              -d CONFIG_IP_NF_MANGLE \
              -d CONFIG_IP6_NF_MANGLE \
              -d CONFIG_BPF_STREAM_PARSER
            echo "└─ 📌 BetterNetwork Disabled"
          fi

          # DroidSpaces Configuration
          echo "└─ 🔧 Configuring DroidSpaces..."
          if [[ "$DROIDSPACES" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -e CONFIG_SYSVIPC \
              -e CONFIG_POSIX_MQUEUE \
              -e CONFIG_PID_NS \
              -e CONFIG_USER_NS \
              -e CONFIG_CGROUP_DEVICE \
              -e CONFIG_CGROUP_PIDS \
              -e CONFIG_DEVTMPFS \
              -e CONFIG_TMPFS_POSIX_ACL \
              -e CONFIG_TMPFS_XATTR \
              -e CONFIG_BRIDGE_NETFILTER \
              -e CONFIG_NF_TABLES \
              -e CONFIG_NETFILTER_XT_MATCH_ADDRTYPE
            echo "└─ 📌 DroidSpaces Configuration Enabled"
          else
            echo "└─ 📌 DroidSpaces Disabled"
          fi

          # NT Synchronization Primitives Configuration
          echo "└─ 🔧 Configuring NTSync..."
          if [[ "$NTSYNC" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_NTSYNC
            echo "└─ 📌 NT Synchronization Primitives Configuration Enabled"
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_NTSYNC
            echo "└─ 📌 NT Synchronization Primitives Disabled"
          fi

          # ReKernel Configuration
          echo "└─ 🔧 Configuring ReKernel..."
          case "$REKERNEL" in
            Built-in)
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                -e CONFIG_REKERNEL \
                -e CONFIG_REKERNEL_NETWORK
                echo "└─ 📌 ReKernel Builtin Configuration Enabled"
              ;;
            Module)
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                -m CONFIG_REKERNEL \
                -e CONFIG_REKERNEL_NETWORK
                echo "└─ 📌 ReKernel Module Configuration Enabled"
              ;;
            None)
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                -d CONFIG_REKERNEL \
                -d CONFIG_REKERNEL_NETWORK
                echo "└─ 📌 ReKernel Disabled"
              ;;
            *)
              echo "└─ ⚠️ Invalid ReKernel Option : $REKERNEL"
              exit 1
              ;;
          esac
          # Baseband Guard Configuration
          # Source Integration Step Runs Earlier; Configuring Baseband Guard After Merged Configuration Exists
          if [[ "${BBG,,}" == "true" ]]; then
            echo "└─ 🛡️ Configuring Baseband Guard..."
            if [[ ! -s "$CONFIGFILE" ]]; then
              echo "└─ ⚠️ Kernel Configuration Not Found : $CONFIGFILE"
              exit 1
            fi
            if [[ ! -x "$CONFIGTOOL" ]]; then
              echo "└─ ⚠️ Kernel Configuration Utility Not Found : $CONFIGTOOL"
              exit 1
            fi

            if ! "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_BBG; then
              echo "└─ ⚠️ Failed to Enable CONFIG_BBG"
              exit 1
            fi

            # Merge Configuration Script '-m' Merges Fragments But Does Not Resolve Kernel Configuration Defaults
            # Resolve Defaults Once so Linux Security Module Configuration is Materialized in Configuration
            LSMVALUE="$(sed -n 's/^CONFIG_LSM="\([^"]*\)"$/\1/p' "$CONFIGFILE")"
            if [[ -z "$LSMVALUE" ]]; then
              echo "└─ ℹ️ Linux Security Module Configuration is Not Yet Materialized; Resolving Kernel Configuration Defaults..."
              if ! make -C "$SOURCEDIR" \
                O="$OUTDIR" \
                LLVM=1 \
                LLVM_IAS=1 \
                ARCH=arm64 \
                olddefconfig; then
                echo "└─ ⚠️ Failed To Resolve Initial Kernel Configuration"
                exit 1
              fi
       
              LSMVALUE="$(sed -n 's/^CONFIG_LSM="\([^"]*\)"$/\1/p' "$CONFIGFILE")"
            fi
     
            if [[ -z "$LSMVALUE" ]]; then
              echo "└─ ⚠️ Linux Security Module Configuration is Still Missing After OldDefConfig"
              grep -n -A16 '^config LSM$' "$SOURCEDIR/security/Kconfig" || true
              exit 1
            fi

            case ",$LSMVALUE," in
              *,baseband_guard,*) ;;
              *) LSMVALUE="${LSMVALUE},baseband_guard" ;;
            esac
         
            if ! "$CONFIGTOOL" --file "$CONFIGFILE" --set-str CONFIG_LSM "$LSMVALUE"; then
              echo "└─ ⚠️ Failed to Configure Linux Security Module Configuration For Baseband Guard"
              exit 1
            fi
      
            echo "└─ 📌 Baseband Guard Configuration Requested : Enabled"
            echo "└─ 📌 Linux Security Module Configuration Requested : $LSMVALUE"
          else
            echo "└─ 🛡️ Baseband Guard disabled by workflow input"
            if ! "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_BBG; then
              echo "└─ ⚠️ Failed to Disable Baseband Guard Configuration"
              exit 1
            fi
          fi

          # Synchronize Final Kernel Configuration
          echo "└─ 🔄 Running OldDefConfig..."
          export LLVM=1
          export LLVM_IAS=1
          make -C "$SOURCEDIR" \
            O="$OUTDIR" \
            LLVM=1 \
            LLVM_IAS=1 \
            ARCH=arm64 \
            olddefconfig
          # Validate Final Kernel Configuration
          if [[ ! -s "$CONFIGFILE" ]] ||
             ! grep -Fxq 'CONFIG_ARM64=y' "$CONFIGFILE"; then
            echo "└─ ⚠️ Final Kernel Configuration is Invalid"
            exit 1
          fi

          # Validate Baseband Guard Survived Kernel Configuration Normalization
          if [[ "${BBG,,}" == "true" ]]; then
            if ! grep -Fxq 'CONFIG_BBG=y' "$CONFIGFILE"; then
              echo "└─ ⚠️ Baseband Guard Configuration Did Not Survive OldDefConfig"
              grep -E '^(CONFIG_BBG|CONFIG_LSM)=' "$CONFIGFILE" || true
              exit 1
            fi
      
            if ! grep -E '^CONFIG_LSM="[^"]*baseband_guard[^"]*"$' "$CONFIGFILE" >/dev/null; then
              echo "└─ ⚠️ Baseband Guard is Missing From Final Linux Security Module Configuration"
              grep '^CONFIG_LSM=' "$CONFIGFILE" || true
              exit 1
            fi
    
          elif grep -Fxq 'CONFIG_BBG=y' "$CONFIGFILE"; then
            echo "└─ ⚠️ Baseband Guard Configuration is Enabled Although Baseband Guard Input is Disabled"
            exit 1
          fi

          # Validate Kernel Local Version
          if ! grep -Fxq "CONFIG_LOCALVERSION=\"$LOCALVERSION\"" "$CONFIGFILE"; then
            echo "└─ ⚠️ Failed to Preserve Kernel Local Version"
            grep '^CONFIG_LOCALVERSION=' "$CONFIGFILE" || true
            exit 1
          fi

          if ! grep -Fxq '# CONFIG_LOCALVERSION_AUTO is not set' "$CONFIGFILE"; then
            echo "└─ ⚠️ Automatic Kernel Local Version Is Not Disabled"
            exit 1
          fi

          # Display Final Root Engine Configuration
          echo "└─ 🔎 Final Root Engine Configuration"
          grep -E \
            '^(CONFIG_KSU|CONFIG_KSU_MULTI_MANAGER_SUPPORT|CONFIG_KSU_TOOLKIT_SUPPORT|CONFIG_KSU_FULL_NAME_FORMAT)=' \
            "$CONFIGFILE" || true
          # Display Final SUSFS Configuration
          echo "└─ 🔎 Final SUSFS Configuration"
          grep -E \
            '^CONFIG_KSU_SUSFS[^=]*=' \
            "$CONFIGFILE" || true
          # Display Final Feature Configuration
          echo "└─ 🔎 Final Feature Configuration"
          grep -E \
            '^(CONFIG_NOMOUNT|CONFIG_BBG|CONFIG_LSM|CONFIG_TCP_CONG_BBR|CONFIG_NTSYNC|CONFIG_REKERNEL|CONFIG_REKERNEL_NETWORK|CONFIG_STATIC_USERMODEHELPER|CONFIG_IP_SET|CONFIG_IP_SET_MAX|CONFIG_BPF_STREAM_PARSER|CONFIG_KASAN)=' \
            "$CONFIGFILE" || true
          # Display Final Local Version
          echo "└─ 🔎 Final Kernel Local Version"
          grep '^CONFIG_LOCALVERSION=' "$CONFIGFILE" || true
          # Display Configuration Summary
          echo "└─ 📊 Assigned Options   : $(grep -c '^CONFIG_.*=' "$CONFIGFILE" || true)"
          echo "└─ 📊 Disabled Options   : $(grep -c '^# CONFIG_.* is not set$' "$CONFIGFILE" || true)"
          echo "└─ 📂 Configuration File : $CONFIGFILE"
          echo "└─ 🎉 Final Kernel Configuration Complete"
