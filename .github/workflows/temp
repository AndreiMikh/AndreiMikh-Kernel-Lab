- name: 🧾 Generate Base Kernel Configuration
        env:
          KERNELSUFFIX: ${{ inputs.KERNELSUFFIX }}
        shell: bash
        run: |
          # Define Kernel Configuration Paths
          CONFIGS="$SOURCEDIR/arch/arm64/configs"
          MERGEBASECONFIGS="$SOURCEDIR/scripts/kconfig/merge_config.sh"
          CONFIGTOOL="$SOURCEDIR/scripts/config"
          CONFIGFILE="$OUTDIR/.config"
          BASECONFIG="$CONFIGS/gki_defconfig"
          PERFCONFIG="$CONFIGS/vendor/sun_perf.config"
          OPLUSCONFIG="$CONFIGS/vendor/oplus/sun_perf.config"
          echo "📥 Generating SM8750 Base Kernel Configuration..."
          echo "📂 Kernel Source : $SOURCEDIR"
          echo "📂 Kernel Output : $OUTDIR"
          echo "📂 Config Path   : $CONFIGS"
          # Validate Kernel Configuration Tools
          for tool in "$MERGEBASECONFIGS" "$CONFIGTOOL"; do
            if [ ! -x "$tool" ]; then
              echo "⚠️ Kernel Configuration Tool Not Found"
              echo "📂 $tool"
              exit 1
            fi

          done

          # Validate Required Configuration Files
          for config in \
            "$BASECONFIG" \
            "$PERFCONFIG" \
            "$OPLUSCONFIG"; do
            if [ ! -f "$config" ]; then
              echo "⚠️ Required Kernel Config Not Found"
              echo "📂 $config"
              exit 1
            fi
            echo "✔️ Found : $config"
    
          done

          # Prepare Kernel Output Directory
          mkdir -p "$OUTDIR"
          rm -f "$CONFIGFILE"
          # Merge Base, Performance, and OPlus Configurations
          echo "🔧 Merging Base Kernel Configurations..."
          KBUILD_OUTPUT="$OUTDIR" \
          KCONFIG_CONFIG="$CONFIGFILE" \
            "$MERGEBASECONFIGS" \
            -m \
            -r \
            "$BASECONFIG" \
            "$PERFCONFIG" \
            "$OPLUSCONFIG"
          # Verify Generated Configuration
          if [ ! -s "$CONFIGFILE" ]; then
            echo "⚠️ Failed to Generate .config"
            exit 1
          fi

          # Set Kernel Local Version Suffix
          if [ -n "$KERNELSUFFIX" ]; then
            LOCALVERSION="-${KERNELSUFFIX}-4k"
          else
            LOCALVERSION="-${SRCCOMMIT}-4k"
          fi

          "$CONFIGTOOL" \
            --file "$CONFIGFILE" \
            --set-str CONFIG_LOCALVERSION "$LOCALVERSION" \
            -d CONFIG_LOCALVERSION_AUTO
          # Verify Local Version Configuration
          if ! grep -Fxq "CONFIG_LOCALVERSION=\"$LOCALVERSION\"" "$CONFIGFILE"; then
            echo "⚠️ Failed to Set Kernel Local Version"
            grep '^CONFIG_LOCALVERSION=' "$CONFIGFILE" || true
            exit 1
          fi

          # Display Final Configuration Summary
          echo "📌 Kernel Local Version:"
          grep '^CONFIG_LOCALVERSION=' "$CONFIGFILE"
          grep '^# CONFIG_LOCALVERSION_AUTO is not set$' "$CONFIGFILE"
          echo "📊 Configuration Summary:"
          echo "├─ Assigned Options : $(grep -c '^CONFIG_.*=' "$CONFIGFILE" || true)"
          echo "├─ Disabled Options : $(grep -c '^# CONFIG_.* is not set$' "$CONFIGFILE" || true)"
          echo "└─ Total Options    : $(grep -Ec '^(CONFIG_.*=|# CONFIG_.* is not set$)' "$CONFIGFILE" || true)"
          echo "🎉 Base Kernel Configuration Generated Successfully"
