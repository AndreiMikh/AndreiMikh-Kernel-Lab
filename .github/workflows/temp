      - name: 🧾 Generate Base Kernel Configuration
        env:
          KERNELSUFFIX: ${{ inputs.KERNELSUFFIX }}
        shell: bash
        run: |
          # Define Kernel Configuration Paths
          CONFIGS="$SOURCEDIR/arch/arm64/configs"
          MERGEBASECONFIGS="$SOURCEDIR/scripts/kconfig/merge_config.sh"
          CONFIGFILE="$OUTDIR/.config"
          BASECONFIG="$CONFIGS/gki_defconfig"
          PERFCONFIG="$CONFIGS/vendor/sun_perf.config"
          OPLUSCONFIG="$CONFIGS/vendor/oplus/sun_perf.config"
          echo "└─ 📥 Generating SM8750 Base Kernel Configuration..."
          echo "└─ 📂 Kernel Source : $SOURCEDIR"
          echo "└─ 📂 Kernel Output : $OUTDIR"
          echo "└─ 📂 Config Path   : $CONFIGS"
          # Validate Merge Script
          if [ ! -x "$MERGEBASECONFIGS" ]; then
            echo "└─ ⚠️ Base Config Merge Script Not Found"
            echo "└─ 📂 Expected : $MERGEBASECONFIGS"
            exit 1
          fi

          # Validate Required Configuration Files
          for config in \
            "$BASECONFIG" \
            "$PERFCONFIG" \
            "$OPLUSCONFIG"; do
            if [ ! -f "$config" ]; then
              echo "└─ ⚠️ Required Kernel Config Not Found"
              echo "└─ 📂 $config"
              exit 1
            fi
            echo "└─ 📌 Found : $config"
      
          done

          # Prepare Kernel Output Directory
          mkdir -p "$OUTDIR"
          rm -f "$CONFIGFILE"
          # Merge Base, Performance, and OPlus Configurations
          echo "└─ 🔧 Merging Base Kernel Configurations..."
          KBUILD_OUTPUT="$OUTDIR" \
          KCONFIG_CONFIG="$CONFIGFILE" \
            "$MERGEBASECONFIGS" \
            -m \
            -r \
            "$BASECONFIG" \
            "$PERFCONFIG" \
            "$OPLUSCONFIG"
          # Verify Generated Configuration
          if [ ! -f "$CONFIGFILE" ]; then
            echo "└─ ⚠️ Failed to Generate .config"
            exit 1
          fi

          echo "└─🧾 Base Kernel Config Generated"
                    # Apply Kernel Local Version
          echo "└─ 🔧 Configuring Kernel Local Version..."
          if [[ -n "$KERNELSUFFIX" ]]; then
            LOCALVERSION="-${KERNELSUFFIX}-4k"
          else
            LOCALVERSION="-${SRCCOMMIT}-4k"
          fi

          "$CONFIGTOOL" --file "$CONFIGFILE" \
            --set-str CONFIG_LOCALVERSION "$LOCALVERSION" \
            -d CONFIG_LOCALVERSION_AUTO
          # Root Engine Configuration
          if [[ "$ROOTENGINE" != "None" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_KSU
            if [[ "$ROOTENGINE" == "BakaSU" ]]; then
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                --set-str CONFIG_KSU_FULL_NAME_FORMAT "%TAG_NAME%" \
                -e CONFIG_KSU_MULTI_MANAGER_SUPPORT \
                -e CONFIG_KSU_TOOLKIT_SUPPORT
            else
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                -d CONFIG_KSU_MULTI_MANAGER_SUPPORT \
                -d CONFIG_KSU_TOOLKIT_SUPPORT
            fi

            # SUSFS Configuration
            if [[ "$SUSFSENGINE" == "true" ]]; then
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                -e CONFIG_KSU_SUSFS \
                -e CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT \
                -e CONFIG_KSU_SUSFS_SUS_PATH \
                -e CONFIG_KSU_SUSFS_SUS_MOUNT \
                -e CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT \
                -e CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT \
                -e CONFIG_KSU_SUSFS_SUS_KSTAT \
                -e CONFIG_KSU_SUSFS_TRY_UMOUNT \
                -e CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT \
                -e CONFIG_KSU_SUSFS_SPOOF_UNAME \
                -e CONFIG_KSU_SUSFS_ENABLE_LOG \
                -e CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS \
                -e CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG \
                -e CONFIG_KSU_SUSFS_OPEN_REDIRECT \
                -e CONFIG_KSU_SUSFS_SUS_MAP \
                -d CONFIG_KSU_SUSFS_SUS_SU
            else
              "$CONFIGTOOL" --file "$CONFIGFILE" \
                -d CONFIG_KSU_SUSFS \
                -d CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT \
                -d CONFIG_KSU_SUSFS_SUS_PATH \
                -d CONFIG_KSU_SUSFS_SUS_MOUNT \
                -d CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT \
                -d CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT \
                -d CONFIG_KSU_SUSFS_SUS_KSTAT \
                -d CONFIG_KSU_SUSFS_TRY_UMOUNT \
                -d CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT \
                -d CONFIG_KSU_SUSFS_SPOOF_UNAME \
                -d CONFIG_KSU_SUSFS_ENABLE_LOG \
                -d CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS \
                -d CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG \
                -d CONFIG_KSU_SUSFS_OPEN_REDIRECT \
                -d CONFIG_KSU_SUSFS_SUS_MAP \
                -d CONFIG_KSU_SUSFS_SUS_SU
            fi
      
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -d CONFIG_KSU \
              -d CONFIG_KSU_MULTI_MANAGER_SUPPORT \
              -d CONFIG_KSU_TOOLKIT_SUPPORT \
              -d CONFIG_KSU_SUSFS \
              -d CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT \
              -d CONFIG_KSU_SUSFS_SUS_PATH \
              -d CONFIG_KSU_SUSFS_SUS_MOUNT \
              -d CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT \
              -d CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT \
              -d CONFIG_KSU_SUSFS_SUS_KSTAT \
              -d CONFIG_KSU_SUSFS_TRY_UMOUNT \
              -d CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT \
              -d CONFIG_KSU_SUSFS_SPOOF_UNAME \
              -d CONFIG_KSU_SUSFS_ENABLE_LOG \
              -d CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS \
              -d CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG \
              -d CONFIG_KSU_SUSFS_OPEN_REDIRECT \
              -d CONFIG_KSU_SUSFS_SUS_MAP \
              -d CONFIG_KSU_SUSFS_SUS_SU
          fi

          # NoMount Configuration
          if [[ "$NOMOUNT" != "None" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_NOMOUNT
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_NOMOUNT
          fi

          # Baseband Guard Configuration
          if [[ "$BBG" == "true" ]]; then
            LSMVALUE="$(sed -n 's/^CONFIG_LSM="\([^"]*\)"$/\1/p' "$CONFIGFILE")"
            if [[ -z "$LSMVALUE" ]]; then
              echo "└─ ⚠️ LSM Configuration Is Missing or Invalid"
              exit 1
            fi

            case ",$LSMVALUE," in
              *,baseband_guard,*) ;;
              *) LSMVALUE="${LSMVALUE},baseband_guard" ;;
            esac
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              --set-str CONFIG_LSM "$LSMVALUE" \
              -e CONFIG_BBG
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_BBG
          fi

          # BBR TCP Congestion Control
          if [[ "$BBR" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_TCP_CONG_BBR
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_TCP_CONG_BBR
          fi

          # BetterNetwork / Netfilter
          if [[ "$BETTERNET" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -e CONFIG_NETFILTER_XT_MATCH_ADDRTYPE \
              -e CONFIG_NETFILTER_XT_SET \
              -e CONFIG_IP_SET \
              --set-val CONFIG_IP_SET_MAX 65534 \
              -e CONFIG_IP_SET_BITMAP_IP \
              -e CONFIG_IP_SET_BITMAP_IPMAC \
              -e CONFIG_IP_SET_BITMAP_PORT \
              -e CONFIG_IP_SET_HASH_IP \
              -e CONFIG_IP_SET_HASH_IPMARK \
              -e CONFIG_IP_SET_HASH_IPPORT \
              -e CONFIG_IP_SET_HASH_IPPORTIP \
              -e CONFIG_IP_SET_HASH_IPPORTNET \
              -e CONFIG_IP_SET_HASH_IPMAC \
              -e CONFIG_IP_SET_HASH_MAC \
              -e CONFIG_IP_SET_HASH_NETPORTNET \
              -e CONFIG_IP_SET_HASH_NET \
              -e CONFIG_IP_SET_HASH_NETNET \
              -e CONFIG_IP_SET_HASH_NETPORT \
              -e CONFIG_IP_SET_HASH_NETIFACE \
              -e CONFIG_IP_SET_LIST_SET \
              -d CONFIG_IP6_NF_NAT \
              -e CONFIG_IP6_NF_TARGET_MASQUERADE \
              -e CONFIG_NETFILTER_XT_TARGET_HL \
              -e CONFIG_IP_NF_TARGET_TTL \
              -e CONFIG_IP6_NF_TARGET_HL \
              -e CONFIG_NETFILTER_XT_MATCH_HL \
              -e CONFIG_IP_NF_MATCH_TTL \
              -e CONFIG_IP6_NF_MATCH_HL \
              -e CONFIG_IP_NF_MANGLE \
              -e CONFIG_IP6_NF_MANGLE \
              -e CONFIG_BPF_STREAM_PARSER
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -d CONFIG_NETFILTER_XT_MATCH_ADDRTYPE \
              -d CONFIG_NETFILTER_XT_SET \
              -d CONFIG_IP_SET \
              -d CONFIG_IP_SET_BITMAP_IP \
              -d CONFIG_IP_SET_BITMAP_IPMAC \
              -d CONFIG_IP_SET_BITMAP_PORT \
              -d CONFIG_IP_SET_HASH_IP \
              -d CONFIG_IP_SET_HASH_IPMARK \
              -d CONFIG_IP_SET_HASH_IPPORT \
              -d CONFIG_IP_SET_HASH_IPPORTIP \
              -d CONFIG_IP_SET_HASH_IPPORTNET \
              -d CONFIG_IP_SET_HASH_IPMAC \
              -d CONFIG_IP_SET_HASH_MAC \
              -d CONFIG_IP_SET_HASH_NETPORTNET \
              -d CONFIG_IP_SET_HASH_NET \
              -d CONFIG_IP_SET_HASH_NETNET \
              -d CONFIG_IP_SET_HASH_NETPORT \
              -d CONFIG_IP_SET_HASH_NETIFACE \
              -d CONFIG_IP_SET_LIST_SET \
              -d CONFIG_IP6_NF_NAT \
              -d CONFIG_IP6_NF_TARGET_MASQUERADE \
              -d CONFIG_NETFILTER_XT_TARGET_HL \
              -d CONFIG_IP_NF_TARGET_TTL \
              -d CONFIG_IP6_NF_TARGET_HL \
              -d CONFIG_NETFILTER_XT_MATCH_HL \
              -d CONFIG_IP_NF_MATCH_TTL \
              -d CONFIG_IP6_NF_MATCH_HL \
              -d CONFIG_IP_NF_MANGLE \
              -d CONFIG_IP6_NF_MANGLE \
              -d CONFIG_BPF_STREAM_PARSER
          fi

          # DroidSpaces Configuration
          if [[ "$DROIDSPACES" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -e CONFIG_SYSVIPC \
              -e CONFIG_POSIX_MQUEUE \
              -e CONFIG_PID_NS \
              -e CONFIG_USER_NS \
              -e CONFIG_CGROUP_DEVICE \
              -e CONFIG_CGROUP_PIDS \
              -e CONFIG_DEVTMPFS \
              -e CONFIG_TMPFS_POSIX_ACL \
              -e CONFIG_TMPFS_XATTR \
              -e CONFIG_BRIDGE_NETFILTER \
              -e CONFIG_NF_TABLES \
              -e CONFIG_NETFILTER_XT_MATCH_ADDRTYPE
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -d CONFIG_SYSVIPC \
              -d CONFIG_POSIX_MQUEUE \
              -d CONFIG_PID_NS \
              -d CONFIG_USER_NS \
              -d CONFIG_CGROUP_DEVICE \
              -d CONFIG_CGROUP_PIDS \
              -d CONFIG_DEVTMPFS \
              -d CONFIG_TMPFS_POSIX_ACL \
              -d CONFIG_TMPFS_XATTR \
              -d CONFIG_BRIDGE_NETFILTER \
              -d CONFIG_NF_TABLES \
              -d CONFIG_NETFILTER_XT_MATCH_ADDRTYPE
          fi

          # NTSync Configuration
          if [[ "$NTSYNC" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_NTSYNC
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" -d CONFIG_NTSYNC
          fi

          # ReKernel Configuration
          if [[ "$REKERNEL" == "true" ]]; then
            "$CONFIGTOOL" --file "$CONFIGFILE" -e CONFIG_REKERNEL
          else
            "$CONFIGTOOL" --file "$CONFIGFILE" \
              -d CONFIG_REKERNEL \
              -d CONFIG_REKERNEL_NETWORK
          fi

          # Disable Static Usermode Helper
          "$CONFIGTOOL" --file "$CONFIGFILE" \
            -d CONFIG_STATIC_USERMODEHELPER
          # Synchronize Final Kernel Configuration
          echo "└─ 🔄 Running Old DefConfig..."
          export LLVM=1
          export LLVM_IAS=1
          make -C "$SOURCEDIR" \
            O="$OUTDIR" \
            LLVM=1 \
            LLVM_IAS=1 \
            ARCH=arm64 \
            olddefconfig
          # Validate Final Kernel Configuration
          if [[ ! -s "$CONFIGFILE" ]] ||
             ! grep -Fxq 'CONFIG_ARM64=y' "$CONFIGFILE"; then
            echo "└─ ⚠️ Final Kernel Configuration Is Invalid"
            exit 1
          fi

          if ! grep -Fxq "CONFIG_LOCALVERSION=\"$LOCALVERSION\"" "$CONFIGFILE"; then
            echo "└─ ⚠️ Failed to Preserve Kernel Local Version"
            exit 1
          fi

          if grep -q '^CONFIG_LOCALVERSION_AUTO=y$' "$CONFIGFILE"; then
            echo "└─ ⚠️ Automatic Kernel Local Version Is Enabled"
            exit 1
          fi

          # Display Final Configuration
          echo "└─ 🔎 Final Root Engine Configuration"
          grep -E \
            '^(CONFIG_KSU|CONFIG_KSU_MULTI_MANAGER_SUPPORT|CONFIG_KSU_TOOLKIT_SUPPORT|CONFIG_KSU_FULL_NAME_FORMAT)=' \
            "$CONFIGFILE" || true
          echo "└─ 🔎 Final SUSFS Configuration"
          grep -E \
            '^CONFIG_KSU_SUSFS[^=]*=' \
            "$CONFIGFILE" || true
          echo "└─ 🔎 Final Feature Configuration"
          grep -E \
            '^(CONFIG_NOMOUNT|CONFIG_BBG|CONFIG_LSM|CONFIG_TCP_CONG_BBR|CONFIG_NTSYNC|CONFIG_REKERNEL|CONFIG_REKERNEL_NETWORK|CONFIG_STATIC_USERMODEHELPER|CONFIG_IP_SET|CONFIG_IP_SET_MAX|CONFIG_BPF_STREAM_PARSER)=' \
            "$CONFIGFILE" || true
          echo "└─ 🔎 Final Local Version"
          grep '^CONFIG_LOCALVERSION=' "$CONFIGFILE" || true
          echo "└─ 📊 Total Configuration Options: $(grep -c '^CONFIG_' "$CONFIGFILE" || true)"
          echo "└─ 📂 Configuration File: $CONFIGFILE"
          echo "└─ 🎉 Final Kernel Configuration Complete"
