# GitHub Composite Action Metadata
name: 🧬 Initialize, Extract, Synchronize and Clean Manifest
description: Locate and Parse Device Manifest, Apply Fallback Configuration, Synchronize Kernel Sources and Clean ABI Protected Exports and Disable Default Configuration Checks
# Define Inputs Required by the Combined Composite Action
inputs:
  FILE:
    description: Device Manifest Configuration File Name Without XML Extension
    required: true
  GITHUBREPOSITORY:
    description: Optional GitHub Repository URL or Owner/Repository Name For Dynamic Manifest Search
    required: false
    default: ""
# Export Manifest Information From the Extraction Step
outputs:
  manifestbasefile:
    description: Normalized Manifest Base File Name Derived From Device Configuration
    value: ${{ steps.extract-info.outputs.manifestbasefile }}
  cpu:
    description: CPU Platform Identifier Extracted From Manifest Revision or Branch
    value: ${{ steps.extract-info.outputs.cpu }}
  value:
    description: Android Version Identity Extracted From Manifest Revision
    value: ${{ steps.extract-info.outputs.value }}
runs:
  using: composite
  steps:
    - name: 🧬 Extract Manifest Information
      id: extract-info
      # Export Composite Action Inputs
      env:
        FILE: ${{ inputs.FILE }}
        GITREPOSITORYINPUT: ${{ inputs.GITHUBREPOSITORY }}
        WORKSPACEDIR: ${{ env.WORKSPACEDIR }}
        GITHUB_TOKEN: ${{ github.token }}
      shell: bash
      # Enable Strict Bash Error Handling
      run: |
        set -Eeuo pipefail      
        # Verify Required Tools
        command -v jq >/dev/null || {
          echo "└─ ⚠️ JQ Not Installed"
          exit 1
        }
        # Switch to GitHub Workspace
        cd "${WORKSPACEDIR:-$GITHUB_WORKSPACE}"
        # Normalize Manifest File Name
        if [[ "$FILE" =~ ^(.+)_([a-zA-Z])$ ]]; then
          MANIFESTFILECONFIG="${FILE%_*}"
        else
          MANIFESTFILECONFIG="$FILE"
        fi

        # Generate Normalized Manifest Base Name
        MANIFESTBASEFILE=$(echo "$MANIFESTFILECONFIG" | sed -E '
          s/_aosp/AOSP/g;
          s/_custom/Custom/g;
          s/_([a-zA-Z0-9])/\U\1/g;
          s/^oneplus/1+/;
          s/^realme/RealMe/;
          s/^oppo/Oppo/
        ')
        # Prepare Manifest Fallback Directory
        mkdir -p ".repo/fallbackmanifests"
        # Define Manifest and README Paths
        XMLPATH=".repo/fallbackmanifests/${FILE}.xml"
        READMEPATH=".repo/fallbackmanifests/README.md"
        # Display Normalized Manifest Information
        echo "└─ 🧾 File                        : $FILE"
        echo "└─ 🧾 Manifest File Configuration : $MANIFESTFILECONFIG"
        echo "└─ 🧾 Manifest Base File          : $MANIFESTBASEFILE"
        # Export Manifest Names for Following Workflow Steps
        {
          echo "MANIFESTFILECONFIG=$MANIFESTFILECONFIG"
          echo "MANIFESTBASEFILE=$MANIFESTBASEFILE"
        } >> "$GITHUB_ENV"
        # Export Step Output
        echo "manifestbasefile=$MANIFESTBASEFILE" >> "$GITHUB_OUTPUT"
        # Define Repository Search Priority
        REPOS=(
          "AndreiMikh|Kernel-Manifest"
          "AndreiMikh|AndreiMikh-Kernel-Lab"
        )
        # Add Dynamic Repository When Provided
        if [[ -n "${GITREPOSITORYINPUT:-}" ]]; then
          # Normalize GitHub Repository Input
          GITREPOSITORYINPUT="${GITREPOSITORYINPUT#https://github.com/}"
          GITREPOSITORYINPUT="${GITREPOSITORYINPUT%/}"
          # Parse Owner and Repository Name
          case "$GITREPOSITORYINPUT" in
            */*)
              OWNER="${GITREPOSITORYINPUT%%/*}"
              REPO="${GITREPOSITORYINPUT##*/}"
              ;;
            *)
              OWNER="$GITREPOSITORYINPUT"
              REPO="Kernel-Manifest"
              ;;
          esac
          # Register Dynamic Repository
          echo "└─ 🧾 Dynamic Repository : ${OWNER}/${REPO}"
          REPOS+=("${OWNER}|${REPO}")
        fi

        # Initialize Manifest Search Results
        MANIFESTFOUNDREPO=""
        MANIFESTFOUNDREPONAME=""
        MANIFESTFOUNDBRANCH=""
        # Search Repositories in Deterministic Priority Order
        for ENTRY in "${REPOS[@]}"; do
          OWNER="${ENTRY%%|*}"
          REPOSITORYNAME="${ENTRY##*|}"
          echo "└─ 🔎 Checking ${OWNER}/${REPOSITORYNAME}"
          BRANCHES=""
          # Query GitHub API with Authentication
          if [[ -n "${GITHUB_TOKEN:-}" ]]; then
            BRANCHES=$(curl \
              --connect-timeout 10 \
              --max-time 20 \
              --fail \
              --silent \
              --show-error \
              -H "Authorization: Bearer $GITHUB_TOKEN" \
              -H "Accept: application/vnd.github+json" \
              "https://api.github.com/repos/${OWNER}/${REPOSITORYNAME}/branches?per_page=100" \
              | jq -r '.[].name? // empty' \
              2>/dev/null || true)
          fi

          # Fallback to Unauthenticated GitHub API
          if [[ -z "$BRANCHES" ]]; then
            BRANCHES=$(curl \
              --connect-timeout 10 \
              --max-time 20 \
              --fail \
              --silent \
              --show-error \
              "https://api.github.com/repos/${OWNER}/${REPOSITORYNAME}/branches?per_page=100" \
              | jq -r '.[].name? // empty' \
              2>/dev/null || true)
          fi

          # Fallback to Git LS-Remote When API is Unavailable
          if [[ -z "$BRANCHES" ]]; then
            echo "└─ ⚠️ GitHub API Failed"
            echo "└─ 🔄 Falling Back to Git LS-Remote..."
            BRANCHES=$(git ls-remote \
              --heads \
              "https://github.com/${OWNER}/${REPOSITORYNAME}.git" \
              2>/dev/null \
              | sed 's|.*refs/heads/||' \
              || true)
          fi

          # Skip Repository When No Branches are Available
          if [[ -z "$BRANCHES" ]]; then
            echo "└─ ⚠️ No Branches Found"
            continue
          fi

          # Search Each Branch For Requested Manifest
          while IFS= read -r BRANCH; do
            [[ -z "$BRANCH" ]] && continue
            echo "└─  → 📃 Trying Branch : $BRANCH"
            # Build Raw GitHub URLs
            XMLURL="https://raw.githubusercontent.com/${OWNER}/${REPOSITORYNAME}/${BRANCH}/${FILE}.xml"
            READMEURL="https://raw.githubusercontent.com/${OWNER}/${REPOSITORYNAME}/${BRANCH}/README.md"
            # Check Whether the Manifest Exists
            if ! curl \
              --fail \
              --silent \
              --show-error \
              --head \
              "$XMLURL" >/dev/null 2>&1; then
              continue
            fi

            echo "└─ ✔️ Found ${FILE}.xml"
            echo "└─ 📂 Repository : ${OWNER}/${REPOSITORYNAME}"
            echo "└─ 🌿 Branch     : ${BRANCH}"
            # Download Manifest to Temporary File
            TMPXML="${XMLPATH}.tmp"
            if ! curl \
              --fail \
              --silent \
              --show-error \
              --location \
              "$XMLURL" \
              -o "$TMPXML"; then
              echo "└─ ⚠️ Manifest Download Failed"
              rm -f "$TMPXML"
              continue
            fi

            # Verify Downloaded Manifest is Not Empty
            if [[ ! -s "$TMPXML" ]]; then
              echo "└─ ⚠️ Downloaded Manifest is Empty"
              rm -f "$TMPXML"
              continue
            fi

            # Move Valid Manifest Into Final Location
            mv "$TMPXML" "$XMLPATH"
            # Download README When Available
            TMPREADME="${READMEPATH}.tmp"
            if curl \
              --fail \
              --silent \
              --show-error \
              --location \
              "$READMEURL" \
              -o "$TMPREADME"; then
              if [[ -s "$TMPREADME" ]]; then
                mv "$TMPREADME" "$READMEPATH"
              else
                rm -f "$TMPREADME"
              fi
            else
              rm -f "$TMPREADME"
            fi

            # Store Successful Repository Information
            MANIFESTFOUNDREPO="$OWNER"
            MANIFESTFOUNDREPONAME="$REPOSITORYNAME"
            MANIFESTFOUNDBRANCH="$BRANCH"
            # Stop Searching After First Successful Match
            break 2
          done <<< "$BRANCHES"
          echo "└─ ⚠️ ${FILE}.XML Not Found in ${OWNER}/${REPOSITORYNAME}"
        done
   
        # Verify a Manifest was Successfully Found
        if [[ -z "$MANIFESTFOUNDREPO" || ! -s "$XMLPATH" ]]; then
          echo "└─ ⚠️ ${FILE}.XML Not Found in Any Repository"
          exit 1
        fi

        # Display Located Manifest Information
        echo "------ Manifest Located ------"
        echo "└─ 📂 Repository : ${MANIFESTFOUNDREPO}/${MANIFESTFOUNDREPONAME}"
        echo "└─ 📂 Branch     : ${MANIFESTFOUNDBRANCH}"
        echo "------------------------------"
        # Export Manifest Location For Following Steps
        {
          echo "MANIFESTREPO=$MANIFESTFOUNDREPO"
          echo "MANIFESTREPONAME=$MANIFESTFOUNDREPONAME"
          echo "MANIFESTBRANCH=$MANIFESTFOUNDBRANCH"
        } >> "$GITHUB_ENV"
        # Parse Manifest Revision
        echo "└─ 📌 Parsing Manifest"
        if command -v xmllint >/dev/null; then
          echo "[Info] Using XML Lint For XML Parsing"
          REVISION=$(xmllint \
            --xpath 'string(//project/@revision)' \
            "$XMLPATH" \
            2>/dev/null || true)
        else
          echo "└─ ⚠️ XML Lint Not Found, Using Grep Fallback"
          REVISION=$(grep \
            -oP '<project[^>]+revision="\K[^"]+' \
            "$XMLPATH" \
            | head -n1 \
            || true)
        fi

        # Extract CPU From Manifest Revision
        CPU=$(echo "$REVISION" | cut -d'/' -f2 | cut -d'_' -f1)
        # Fallback to Manifest Branch
        if [[ -z "$CPU" || "$CPU" =~ ^[[:xdigit:]]{40}$ ]]; then
          if [[ "$MANIFESTFOUNDBRANCH" =~ ^oneplus/([^/]+)$ ]]; then
            CPU="${MANIFESTFOUNDBRANCH#oneplus/}"
          fi
        fi

        if [[ -z "$CPU" ]]; then
          echo "└─ ⚠️ CPU Could Not be Determined"
          echo "└─ 📌 Manifest Branch   : ${MANIFESTFOUNDBRANCH:-Unknown}"
          echo "└─ 📌 Manifest Revision : ${REVISION:-Unknown}"
          exit 1
        fi

        echo "└─ 📌 CPU : $CPU"         
        # Extract Android Version From Manifest Revision
        VANDROID=$(echo "$REVISION" \
          | grep -oP '\d+\.\d+(\.\d+)?' \
          | head -n1 \
          || true)
        # Extract Android Major Version
        ASHORTVERSION="${VANDROID%%.*}"
        # Export Parsed Manifest Information
        {
          echo "CPU=$CPU"
          echo "VANDROID=$VANDROID"
          echo "ASHORTVERSION=$ASHORTVERSION"
        } >> "$GITHUB_ENV"
        # Export CPU as a Step Output
        echo "cpu=$CPU" >> "$GITHUB_OUTPUT"
        # Parse README Build Information
        CPUD=""
        BUILDMETHOD=""
        if [[ -s "$READMEPATH" ]]; then
          BUILDLINE=$(grep \
            -m1 \
            'oplus_build_kernel.sh' \
            "$READMEPATH" \
            || true)
          if [[ -n "$BUILDLINE" ]]; then
            CPUD=$(awk '{print $(NF-1)}' <<< "$BUILDLINE")
            BUILDMETHOD=$(awk '{print $NF}' <<< "$BUILDLINE")
            {
              echo "CPUD=$CPUD"
              echo "BUILDMETHOD=$BUILDMETHOD"
            } >> "$GITHUB_ENV"
          fi
        fi
      
        # Output Combined Manifest Identity
        echo "value=Android${VANDROID:-Unknown}" >> "$GITHUB_OUTPUT"
        echo "└─ 🎉 Manifest Parsing Complete"

    # Initialize Selected Manifest, Enforce Fallback Configuration and Synchronize Sources
    - name: 🔄 Initialize and Sync Repository
      shell: bash
      env:
        # Export and Import Workspace and Selected Manifest Configuration        
        FILE: ${{ inputs.FILE }}
        WORKDIR: ${{ env.WORKDIR }}
      # Enable Strict Bash Error Handling
      run: |
        set -Eeuo pipefail
        # Configure Runner Timezone (UTC+0800)
        export TZ="Etc/GMT-8"
        timezone() {
          date '+%Y-%m-%d %H:%M:%S UTC%z'
        }
        echo "🕒 Start Time : $(timezone)"
        # Optimize Git for Faster and More Reliable Repository Synchronization
        echo "⚙️ Applying Git Performance Tweaks.."
        # Increase Number of Parallel Git Fetch Operations
        git config --global fetch.parallel 16
        # Disable Git Compression to Reduce CPU Overhead During Fetching
        git config --global core.compression 0
        # Use Git Protocol Version 2 For More Efficient Communication
        git config --global protocol.version 2
        # Disable Interactive Authentication Prompts
        export GIT_TERMINAL_PROMPT=0
        # Prevent Git From Aborting Slow HTTP Transfers
        export GIT_HTTP_LOW_SPEED_LIMIT=0
        export GIT_HTTP_LOW_SPEED_TIME=999999
        # Move to Kernel Workspace
        cd "$WORKDIR"
        # Validate the Selected Manifest Name Before Accessing Files
        if [[ -z "${FILE:-}" || "$FILE" == */* || "$FILE" == *..* ]]; then
          echo "└─ ⚠️ Invalid Manifest Configuration : ${FILE:-<Empty>}"
          exit 1
        fi

        # Define Manifest Repository and File Paths
        MANIFESTBASE="https://github.com/${MANIFESTREPO}/${MANIFESTREPONAME}.git"
        MANIFESTFILE=".repo/manifests/${FILE}.xml"
        FALLBACKMANIFEST="$GITHUB_WORKSPACE/.repo/fallbackmanifests/${FILE}.xml"
        # Validate Required Fallback Manifest
        if [[ ! -f "$FALLBACKMANIFEST" ]]; then
          echo "└─ ⚠️ Fallback Manifest Not Found : $FALLBACKMANIFEST"
          exit 1
        fi

        # Initialize Repository Only When Required
        echo "└─ 🚀 Initializing Repository..."
        if [[ ! -d ".repo" || ! -f "$MANIFESTFILE" ]]; then
          echo "└─ 🔄 Running Repository Initialization (Missing or New Manifest)..."
          repo init \
            -u "$MANIFESTBASE" \
            -b "$MANIFESTBRANCH" \
            -m "${FILE}.xml" \
            --depth=1 \
            --no-clone-bundle \
            --no-tags
        else
          echo "└─ ⚡ Repository Initialized, Skipping Initialization..."
        fi

        # Enforce Fallback Manifest Only When Contents Differ
        # Keeps Fallback Manifest as Source of Truth Without Repeatedly Copying an Identical File
        echo "└─ 📥 Checking Fallback Manifest..."
        mkdir -p .repo/manifests
        if ! cmp -s "$FALLBACKMANIFEST" "$MANIFESTFILE"; then
          echo "└─ 🔄 Updating Fallback Manifest..."
          cp "$FALLBACKMANIFEST" "$MANIFESTFILE"
        else
          echo "└─ ⚡ Fallback Manifest Unchanged, Skipping Copy"
        fi

        # Remove Unwanted KS-Kernel.LNX.5.0.R3-Rel Manifest Prebuilt Entries
        # Apply Cleanup After Copying so Fallback Manifest is Always the Baseline Configuration
        echo "└─ 🧹 Removing Unwanted KS-Kernel.LNX.5.0.R3-Rel Manifest Prebuilt Entries..."
        sed -i \
          -e '/prebuilts\/asuite"/{/ks-kernel\.lnx\.5\.0\.r3-rel/d}' \
          -e '/tools\/tradefederation\/prebuilts"/{/ks-kernel\.lnx\.5\.0\.r3-rel/d}' \
          "$MANIFESTFILE"
        # Display Configured Repository Projects
        echo "📃 Repository List :"
        repo list || true
        # Check Whether CodeLinaro Build-Tools Repository is Reachable
        echo "└─ 🔎 Testing CodeLinaro Repository..."
        if timeout 15s git ls-remote \
          https://git.codelinaro.org/clo/la/kernel/prebuilts/build-tools \
          >/dev/null 2>&1; then
          echo "└─ CodeLinaro Repository : 🟢 Online"
        else
          STATUS=$?
          if [[ "$STATUS" -eq 124 ]]; then
            echo "└─ CodeLinaro Repository : 🟠 Not Responsive"
          else
            echo "└─ CodeLinaro Repository : 🔴 Unreachable"
          fi
        fi

        # Prepare Repository Synchronization Options
        echo "└─ 📁 Syncing Repository..."
        # Use an Array to Preserve Each Repository Synchronization Argument
        SYNCFLAGS=(
          -c
          --force-sync
          --no-clone-bundle
          --no-tags
          --optimized-fetch
          --prune
          --retry-fetches=5
          --verbose
          "-j$(nproc)"
        )
        echo "└─ ⚡ Using $(nproc) Parallel Jobs"
        # Start Watchdog to Report Synchronization Progress
        (
          while true; do
            sleep 60
            echo "└─ ⏳ Syncing Alive... $(timezone)"
          done
        ) &
        WATCHDOGPID=$!
        # Ensure Watchdog is Stopped When Step Exits
        cleanupwatchdog() {
          if [[ -n "${WATCHDOGPID:-}" ]]; then
            kill "$WATCHDOGPID" >/dev/null 2>&1 || true
            wait "$WATCHDOGPID" 2>/dev/null || true
          fi
        }
        trap cleanupwatchdog EXIT
        # Synchronize All Projects with a 15-Minute Timeout
        if timeout 15m repo sync "${SYNCFLAGS[@]}"; then
          SYNCSTATUS=0
        else
          SYNCSTATUS=$?
        fi

        # Stop Watchdog After Synchronization Finishes
        cleanupwatchdog
        trap - EXIT
        # Stop Workflow if Repository Synchronization Fails
        if [[ "$SYNCSTATUS" -ne 0 ]]; then
          if [[ "$SYNCSTATUS" -eq 124 ]]; then
            echo "└─ ⚠️ Repository Sync Timed Out After 15 Minutes"
          else
            echo "└─ ⚠️ Repository Sync Failed (Exit Code : $SYNCSTATUS)"
          fi

          exit 1
        fi

        echo "└─ ⚡ Repository Sync Completed"
        # Inspect Repository Metadata and Directory Sizes
        echo "└─ 📂 Inspecting Repository Directory..."
        echo "------------ Root ------------"
        ls -la .repo/ || true
        echo "---------- Manifest ----------"
        ls -la .repo/manifests/ || true
        echo "------------ Tool ------------"
        ls -la .repo/repo || true
        # Display Sizes of Individual Repository Metadata Directories
        echo "└─ 📊 Repository Breakdown    :"
        du -sh .repo/* 2>/dev/null || true
        # Display Total Repository Metadata Size
        echo "└─ 📊 Repository Size Summary :"
        du -sh .repo || true
        # Locate a Build Configuration to Identify Kernel Repository
        echo "└─ 🔎 Detecting Kernel Repository..."
        KREPOSPATH=$(
          find . \
            -type f \
            -name "build.config*" \
            -not -path "*/.repo/*" \
            -print -quit
        )
        # Fail if No Kernel Build Configuration was Found
        if [[ -z "$KREPOSPATH" ]]; then
          echo "└─ ⚠️ No Build Configuration Found"
          exit 1
        fi

        # Derive Kernel Repository Path From Build Configuration
        echo "└─ 📌 Build Configuration Found  : $KREPOSPATH"
        KERNELREPOSITORY=$(dirname "${KREPOSPATH#./}")
        echo "└─ 🔎 Detected Kernel Repository : $KERNELREPOSITORY"
        # Export Detected Kernel Repository For Subsequent Workflow Steps
        echo "KERNELREPOSITORY=$KERNELREPOSITORY" >> "$GITHUB_ENV"
        echo "🎉 Kernel Repository Pipeline Complete"

    # Clean ABI Protected Exports and Disable Default Configuration Checks
    - name: 🧹 Cleanup Kernel Repository
      shell: bash
      # Import Environment Variables
      env:
        # Kernel Workspace and Platform Directory
        WORKDIR: ${{ env.WORKDIR }}
        KERNELPLATFORM: ${{ env.KERNELPLATFORM }}
      # Enable Strict Error Handling
      run: |
        set -euo pipefail
        # Navigate to Kernel Platform Directory
        cd "$KERNELPLATFORM"
        # Cleanup ABI Protected Exports
        echo "└─ 🧹 Cleaning ABI Protected Exports..."     
        # Remove ABI Protected Export Metadata
        rm -f common/android/abi_gki_protected_exports_* || true
        # Disable Protected Module Validation
        sed -i 's/protected_modules = \[.*\]/protected_modules = []/' common/modules.bzl || true
        # Remove Protected Export References From Bazel Build Files
        for directory in common msm-kernel; do
          file="$directory/BUILD.bazel"
          if [[ -f "$file" ]]; then
            sed -i '/protected_exports_list/d' "$file"
          fi
        done

        # Return to Kernel Workspace
        cd "$WORKDIR"
        # Disable Default Configuration Checks
        echo "└─ 🧹 Disabling Default Configuration Checks..."
        # Remove check_defconfig References from GKI Build Configurations
        # Prevent CI or Build Failures Caused by Default Configuration Validation
        find . -type f -name "build.config.gki" \
          -exec grep -q "check_defconfig" {} \; \
          -exec sed -i '/check_defconfig/d' {} \; \
          2>/dev/null || true
        # Explicitly Disable KLeaf Default Configuration Validation
        find . -type f -name "common_kernels.bzl" \
          -exec sed -i \
          's/check_defconfig *= *None,/check_defconfig = "disabled",/g' {} + \
          2>/dev/null || true
        # Disable Kleaf Conditional Default Configuration Check
        # Original : if Check Default Configuration == None:
        # Patched  :  if False:  # Disabled by CI
        find . -type f -name "common_kernels.bzl" \
          -exec sed -i \
          's/if check_defconfig == None:/if False:  # Disabled by CI/g' {} + \
          2>/dev/null || true
        # Confirm Default Configuration Checks are Disabled
        echo "└─ 🎉 Default Configuration Checks Disabled"
