# SUSFS and Kernel Compatibility Patches Composite Action
name: 🩹 SUSFS and Kernel Compatibility Patches
description: Apply SUSFS Patches, Kernel Compatibility Fixes and Fake Patch Handling
# Define Inputs Required by Composite Action
inputs:
  # Select Root Engine Used by Kernel Build
  ROOTENGINE:
    description: Root Engine
    required: true
  # Select a SuSFS Commit, Tag, Branch or Numeric Rollback Value
  SUSFSREPOSITORY:
    description: SuSFS Revision or Rollback Value
    required: true
  # Select SuSFS Repository Variant
  SUSFSVARIANT:
    description: SuSFS Variant (GKI or OGKI)
    required: true
  # Append Development Suffix to Selected SuSFS Branch When Enabled
  SUSFSBRANCHDEV:
    description: SuSFS Development Branch
    required: true
  # Specify Target Kernel Configuration
  FILE:
    description: Kernel Target Configuration
    required: true
# Expose Detected SuSFS Version to Subsequent Workflow Steps
outputs:
  susfsver:
    description: Detected SuSFS Version
    value: ${{ steps.susfs.outputs.susfsver }}
runs:
  using: composite
  steps:
    # These Changes Prepare Older or Newer Kernel Sources For SUSFS Patch
    # Apply Kernel Fake Patches Before SuSFS Integration
    # Apply Temporary Kernel Compatibility Fixes Before SuSFS Integration
    - name: 📥 Invert Fake Patches
      if: ${{ inputs.SUSFSREPOSITORY != '-1' }}
      shell: bash
      env:
        COMMONKERNELFOLDER: ${{ env.COMMONKERNELFOLDER }}
        SCRIPTSDIR: ${{ env.SCRIPTSDIR }}
      run: |
        set -e
        # Define Fake Patches Script Path
        FAKESCRIPT="${SCRIPTSDIR}/FakePatches/SuSFS-Compat.kts"
        echo "└─ 📌 Script   : $FAKESCRIPT"
        # Verify Kotlin Compiler Availability and Version
        echo "└─ ☕ Kotlin Compiler :"
        kotlinc -version
        # Apply Fake Patches to Prepare For SUSFS Integration
        echo "└─ 🔧 Applying Fake Patches..."
        kotlinc -script "$FAKESCRIPT" apply "$COMMONKERNELFOLDER"
        # Confirm Fake Patches were Applied Successfully
        echo "🎉 Fake Patches Applied Successfully"
   
    # Clone SuSFS and Apply Patches
    - name: 🩹 SuSFS Integration
      id: susfs
      if: ${{ inputs.SUSFSREPOSITORY != '-1' }}
      shell: bash
      # Export Composite Action Inputs and Import Environment Variables
      env:
        # Kernel Build Paths From Caller Environment
        WORKDIR: ${{ env.WORKDIR }}
        COMMONKERNELFOLDER: ${{ env.COMMONKERNELFOLDER }}
        SCRIPTSDIR: ${{ env.SCRIPTSDIR }}
        PATCHDIR: ${{ env.PATCHDIR }}
        REJECTCHECKER: ${{ env.REJECTCHECKER }}
        # Root Engine and SuSFS Configuration
        ROOTENGINE: ${{ inputs.ROOTENGINE }}
        SUSFSREPOSITORY: ${{ inputs.SUSFSREPOSITORY }}
        SUSFSVARIANT: ${{ inputs.SUSFSVARIANT }}
        SUSFSBRANCHDEV: ${{ inputs.SUSFSBRANCHDEV }}
        FILE: ${{ inputs.FILE }}
        # Kernel Version Information
        ANDROIDVERSION: ${{ env.ANDROIDVERSION }}
        KERNELVERSION: ${{ env.KERNELVERSION }}
        SUBLEVEL: ${{ env.SUBLEVEL }}
      run: |
        set -euo pipefail
        # Construct Android and Kernel Version Identifier
        GKIVERSION="${ANDROIDVERSION}-${KERNELVERSION}"
        # Kotlin Environment
        FAKESCRIPT="${SCRIPTSDIR}/FakePatches/SuSFS-Context.kts"
        # Navigate to Kernel Working Directory
        cd "$WORKDIR"
        # Display Kernel Environment Information
        echo "└─ 🧾 Android Version       : $ANDROIDVERSION"
        echo "└─ 🧾 Kernel Version        : $KERNELVERSION"
        echo "└─ 🔎 Detected Kernel Base  : $GKIVERSION"
        echo "└─ 📁 Kernel Directory      : $COMMONKERNELFOLDER"
        echo "└─ 📌 Script                : $FAKESCRIPT"
        # Select SuSFS Repository, Branch and Optional Fallback
        echo "└─ 📥 Cloning SuSFS..."
        if [[ "$SUSFSVARIANT" == "OGKI" ]]; then
          # Select OGKI Repository and Branch
          BRANCH="oki-${ANDROIDVERSION}-${KERNELVERSION}"
          REPOURL="https://github.com/cctv18/susfs4oki.git"
          FALLBACKURL=""
        else
          # Select GKI Repository and GitHub Mirror
          BRANCH="gki-${ANDROIDVERSION}-${KERNELVERSION}"
          REPOURL="https://gitlab.com/simonpunk/susfs4ksu.git"
          FALLBACKURL="https://github.com/AndreiMikh/susfs4ksu.git"
        fi

        # Append Development Suffix When Enabled
        if [[ "$SUSFSBRANCHDEV" == "true" ]]; then
          BRANCH="${BRANCH}-dev"
        fi

        # Attempt to Clone Selected Branch up to Three Times
        CLONED=false
        for attempt in {1..3}; do
          # Remove Any Previous Failed Clone
          rm -rf susfs4ksu
          # Clone Requested Branch with Shallow History
          if git clone --depth=1 --single-branch \
            --branch "$BRANCH" \
            "$REPOURL" susfs4ksu; then
            echo "└─ 📌 SuSFS Clone Successful"
            CLONED=true
            break
          fi

          # Remove an Incomplete Repository Before Retrying
          rm -rf susfs4ksu
          # Delay Between Retry Attempts
          if [[ "$attempt" -lt 3 ]]; then
            echo "└─ ⚠️ Clone Failed (Attempt $attempt/3)"
            sleep $((attempt * 3))
          fi

        done

        # Try GitHub Mirror if Primary Clone Failed
        if [[ "$CLONED" != "true" && -n "$FALLBACKURL" ]]; then
          echo "└─ ⚠️ GitLab Unavailable, Trying GitHub Mirror..."
          if git clone --depth=1 --single-branch \
            --branch "$BRANCH" \
            "$FALLBACKURL" susfs4ksu; then
            echo "└─ 📌 SuSFS GitHub Mirror Clone Successful"
            CLONED=true
          fi
        fi

        # Stop Build if No Repository Could be Cloned
        if [[ "$CLONED" != "true" ]]; then
          echo "└─ ⚠️ SuSFS Clone Failed"
          echo "└─ 📦 Repository : $REPOURL"
          echo "└─ 🌿 Branch     : $BRANCH"
          [[ -z "$FALLBACKURL" ]] || echo "└─ 🔄 Fallback   : $FALLBACKURL"
          exit 1
        fi

        # Display Selected SuSFS Branch
        echo "└─ 📌 SuSFS Branch : $BRANCH"
        # Enter Cloned SuSFS Repository
        cd susfs4ksu || exit 1
        # Check Whether a Specific SuSFS Revision was Requested
        if [[ -n "${SUSFSREPOSITORY:-}" && "$SUSFSREPOSITORY" != "-1" ]]; then
          echo "└─ 🔎 SuSFS Revision : $SUSFSREPOSITORY"
          # Numeric Values Select a Previous Commit Relative to HEAD
          if [[ "$SUSFSREPOSITORY" =~ ^[0-9]+$ ]]; then
            echo "└─ 📦 Fetching Additional Git History..."
            # Expand Shallow Clone or Fetch Additional History
            git fetch --unshallow || git fetch --depth=1000 origin "$BRANCH"
            # Check Out Requested Historical Commit
            git checkout "HEAD~$SUSFSREPOSITORY" || {
              echo "└─ ⚠️ Failed Checkout HEAD~$SUSFSREPOSITORY"
              exit 1
            }
          else
            # Expand History When a Commit Hash is Supplied
            if [[ "$SUSFSREPOSITORY" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
              echo "└─ 📦 Expanding Shallow Clone History..."
              git fetch --unshallow origin || \
                git fetch --deepen=200 origin "$BRANCH"
            fi

            # Check Out Requested Commit, Tag or Branch
            git checkout "$SUSFSREPOSITORY" || {
              echo "└─ ⚠️ Invalid SuSFS Revision"
              exit 1
            }
          fi
        fi

        # Display Active SuSFS Commit
        echo "└─ 📌 Active SuSFS Commit : $(git rev-parse --short HEAD)"
        # Detect SuSFS Version From its Header
        SUSFSVER="Unknown"
        SUSFSHEADER="./kernel_patches/include/linux/susfs.h"
        if [[ -f "$SUSFSHEADER" ]]; then
          SUSFSVER=$(
            awk -F'"' '/SUSFS_VERSION/ {print $2; exit}' "$SUSFSHEADER"
          )
          SUSFSVER="${SUSFSVER:-Unknown}"
        fi

        # Export SuSFS Version to Workflow Environment and Step Output
        echo "└─ 📦 SuSFS Version : $SUSFSVER"
        echo "SUSFSVER=$SUSFSVER" >> "$GITHUB_ENV"
        echo "susfsver=$SUSFSVER" >> "$GITHUB_OUTPUT"
        # Return to the Working Directory
        cd ..
        # Find SuSFS Core Patch Files Matching Current Kernel Base
        echo "└─ 🔎 Searching SuSFS Patches..."
        shopt -s nullglob
        SUSFSPATCHLIST=(./susfs4ksu/kernel_patches/50_add_susfs_in_gki-"${ANDROIDVERSION}"-"${KERNELVERSION}"*.patch)
        # Stop if No Matching SuSFS Patch Exists
        if [[ ${#SUSFSPATCHLIST[@]} -eq 0 ]]; then
          echo "└─ ⚠️ No SuSFS Patch Found"
          ls ./susfs4ksu/kernel_patches/ || true
          exit 1
        fi

        # Select Last Matching Patch From Sorted Array
        SUSFSPATCH="${SUSFSPATCHLIST[-1]}"
        # Copy SuSFS Patch Files Into Common Kernel Source Tree
        echo "└─ 🧾 SuSFS Patch Directory : $SUSFSPATCH"
        if [[ "$SUSFSREPOSITORY" != "-1" ]]; then
          echo "└─ 📥 Copying SuSFS Patches..."
          # Copy Main SuSFS Patch
          cp "$SUSFSPATCH" "${COMMONKERNELFOLDER}/" 2>/dev/null || \
            echo "└─ ⚠️ Failed to Copy SuSFS Patches"
          # Copy SuSFS File System Changes
          cp -r ./susfs4ksu/kernel_patches/fs/* "${COMMONKERNELFOLDER}/fs/" 2>/dev/null || \
            echo "└─ ⚠️ Failed to Copy SuSFS File System"
          # Copy SuSFS Linux Header Changes
          cp -r ./susfs4ksu/kernel_patches/include/linux/* "${COMMONKERNELFOLDER}/include/linux/" 2>/dev/null || \
            echo "└─ ⚠️ Failed to Copy SuSFS Linux Header"
        fi

        # Enter Common Kernel Source Directory
        cd "$COMMONKERNELFOLDER"
        # Resolve Exact Selected SuSFS Patch File Name
        SUSFSPATCHNAME="$(basename "$SUSFSPATCH")"
        LOCALSUSFSPATCH="${COMMONKERNELFOLDER}/${SUSFSPATCHNAME}"
        # Verify Selected SuSFS Patch was Copied
        if [[ ! -f "$LOCALSUSFSPATCH" ]]; then
          echo "└─ ⚠️ SuSFS Patch Not Found : $LOCALSUSFSPATCH"
          exit 1
        fi

        # Detect Whether SuSFS Core Patch is Already Applied
        echo "└─ 🔎 Checking SuSFS Core Patch Status..."
        if patch -R -p1 --dry-run < "$LOCALSUSFSPATCH" >/dev/null 2>&1; then
          echo "└─ ℹ️ SuSFS Core Patch Already Applied; Skipping"
        else
          # Restore Missing Include Context Before Applying SuSFS
          echo "└─ 🧩 Restoring SuSFS Patch Context..."
          kotlinc -script "$FAKESCRIPT" \
            "$COMMONKERNELFOLDER" "$LOCALSUSFSPATCH"
          # Apply SuSFS Core Patch
          echo "└─ ⚙️ Applying SuSFS Core Patch (50 Add SuSFS Patch)"
          if patch -p1 < "$LOCALSUSFSPATCH"; then
            echo "└─ 📌 SuSFS Core Patch Applied Successfully"
          else
            echo "└─ ⚠️ SuSFS Core Patch Failed"
          fi
        fi

        # Apply SuSFS Enable Patch Only For KernelSU
        if [[ "$ROOTENGINE" == "KernelSU" ]]; then
          echo "⚙️ Applying KernelSU SuSFS Enable Patch"
          # Select Branch For SuSFS Enable Patch
          if [[ "$SUSFSVARIANT" == "OGKI" ]]; then
            PATCHBRANCH="oki-${ANDROIDVERSION}-${KERNELVERSION}"
          else
            PATCHBRANCH="gki-${ANDROIDVERSION}-${KERNELVERSION}"
          fi

          # Append Development Suffix When Enabled
          [[ "${SUSFSBRANCHDEV}" == "true" ]] && PATCHBRANCH="${PATCHBRANCH}-dev"
          # Build SuSFS Enable Patch URL Based on Variant
          case "$SUSFSVARIANT" in
            GKI)
              SUSFS10URL="https://gitlab.com/simonpunk/susfs4ksu/-/raw/${PATCHBRANCH}/kernel_patches/${ROOTENGINE}/10_enable_susfs_for_ksu.patch"
              ;;
            OGKI)
              SUSFS10URL="https://raw.githubusercontent.com/cctv18/susfs4oki/${PATCHBRANCH}/kernel_patches/${ROOTENGINE}/10_enable_susfs_for_ksu.patch"
              ;;
            *)
              # Reject Unsupported SuSFS Variants
              echo "└─ ⚠️ Invalid SuSFS Variant"
              exit 1
              ;;
          esac
          # Verify SuSFS Enable Patch URL is Reachable
          echo "🔍 Checking Patch URL..."
          if ! wget --spider "$SUSFS10URL"; then
            echo "└─ ⚠️ Patch Does Not Exist :"
            echo "$SUSFS10URL"
            exit 1
          fi

          # Download SuSFS Enable Patch
          echo "🌐 Downloading Patch : $SUSFS10URL"
          if ! wget "$SUSFS10URL" -O enable.patch; then
            echo "└─ ⚠️ Failed to Download SuSFS Enable Patch"
            exit 1
          fi

          # Track Whether Enable Patch was Applied Successfully
          APPLIED=false
          # Save Current Directory For Cleanup and Return
          ORIGDIR="$(pwd)"
          # Resolve KernelSU Source Directory
          KSUDIR="$(dirname "$COMMONKERNELFOLDER")/KernelSU"
          echo "└─ 📂 Current Directory : $(pwd)"
          echo "└─ 🔧 Applying SuSFS Enable Patch..."
          # Stop if KernelSU Source Directory is Missing
          if [[ ! -d "$KSUDIR" ]]; then
            echo "└─ ⚠️ KernelSU Directory Not Found :"
            echo "└─ $KSUDIR"
            rm -f "$ORIGDIR/enable.patch"
            exit 1
          fi

          # Enter KernelSU Source Directory
          echo "└─ 📂 Entering KernelSU Directory..."
          cd "$KSUDIR" || exit 1
          echo "└─ 📂 Current Directory : $(pwd)"
          echo "└─ 🔧 Applying SuSFS Enable Patch..."
          # Apply SuSFS Enable Patch
          if patch -p1 < "$ORIGDIR/enable.patch"; then
            APPLIED=true
            echo "📌 SuSFS Enable Patch Applied Successfully"
          else
            # Preserve Original Behavior: Warn and Skip on Failure
            echo "└─ ⚠️ SuSFS Enable Patch is Not Compatible with KernelSU Source Tree"
            echo "└─ ℹ️ Skipping SuSFS Enable Patch"
          fi

          # Return to Original Directory and Remove Temporary Patch
          echo "└─ 📂 Returning to Original Directory..."
          cd "$ORIGDIR" || exit 1
          rm -f "$ORIGDIR/enable.patch"
          # Report Final Enable Patch Status
          if [[ "$APPLIED" == "true" ]]; then
            echo "└─ 📌 KernelSU SuSFS Enable Patch Completed"
          else
            echo "└─ ⚠️ KernelSU SuSFS Enable Patch Skipped"
          fi

        else
          # Skip KernelSU Enable Patch For Other Root Engines
          echo "└─ ♻️ Skipping KernelSU SuSFS Enable Patch (Root = $ROOTENGINE)"
        fi

        echo "🎉 SuSFS Patches Complete"
        # Apply Legacy Compatibility Fix For Older Android 13 Kernel 5.15 Builds
        if [[ "$GKIVERSION" == "android13-5.15" && "$SUBLEVEL" -lt 123 ]]; then
          # Resolve Legacy Compatibility Patch Path
          LEGACYPATCH="${PATCHDIR}/Legacy-5.15-Fix.patch"
          # Stop if Required Legacy Patch is Missing
          if [[ ! -f "$LEGACYPATCH" ]]; then
            echo "└─ ⚠️ Patch Not Found : $LEGACYPATCH"
            exit 1
          fi

          echo "└─ 🚀 Applying Legacy Fix (Kernel 5.15.0–5.15.123)"
          # Skip Patch if it is Already Applied
          if patch -R -p1 --dry-run < "$LEGACYPATCH" >/dev/null 2>&1; then
            echo "└─ ⚠️ Patch Already Applied — Skipping"
          else
            # Apply Legacy Fix
            if patch -p1 < "$LEGACYPATCH"; then
              echo "📌 Legacy 5.15 Fix Applied"
            else
              echo "└─ ⚠️ Patch Failed"
              exit 1
            fi
          fi
        fi

        # Load Reject Checker and Check For Patch Rejects
        source "$REJECTCHECKER"
        checkrejects .
        echo "└─ 🎉 Kernel Compatibility Fix Stage Completed"

    # Reverse Temporary Kernel Compatibility Fixes After SuSFS Integration
    - name: 📤 Revert Fake Patches
      if: ${{ inputs.SUSFSREPOSITORY != '-1' }}
      shell: bash
      env:
        COMMONKERNELFOLDER: ${{ env.COMMONKERNELFOLDER }}
        SCRIPTSDIR: ${{ env.SCRIPTSDIR }}
      run: |
        set -e
        # Define Fake Patches Script Path
        FAKESCRIPT="${SCRIPTSDIR}/FakePatches/SuSFS-Compat.kts"
        # Display Script and Compiler Paths
        echo "└─ 📌 Script   : $FAKESCRIPT"
        # Apply Post-Fix Adjustments Before Reverting Fake Patches
        echo "└─ 🔧 Running Fake Patches PostFix..."
        kotlinc -script "$FAKESCRIPT" postfix "$COMMONKERNELFOLDER"
        # Revert Fake Patches and Restore Original Kernel Source
        echo "└─ 🔄 Reverting Fake Patches..."
        kotlinc -script "$FAKESCRIPT" revert "$COMMONKERNELFOLDER"
        # Confirm Fake Patches were Reverted Successfully
        echo "🎉 Fake Patches Reverted Successfully"
