name: "Native Kernel FakePatches"
description: "Apply, Post-Fix, or Revert Native Bash / Perl Kernel Compatibility FakePatches"

inputs:
  mode:
    description: "FakePatches Operation: Apply, PostFix, or Revert"
    required: true
    default: Apply
  kernel-module:
    description: "Kernel Base / Family"
    required: true
  sublevel:
    description: "Kernel Sublevel Number"
    required: false
    default: "0"
  common-kernel-folder:
    description: "Path to Kernel Source Tree"
    required: true

runs:
  using: composite
  steps:
    - name: Run ${{ inputs.mode }} FakePatches
      shell: bash
      env:
        KERNELMODULE: ${{ inputs.kernel-module }}
        SUBLEVEL: ${{ inputs.sublevel }}
        COMMONKERNELFOLDER: ${{ inputs.common-kernel-folder }}
        FAKEPATCHMODE: ${{ inputs.mode }}
      run: |
        set -e
        # Validate Required Inputs Before Touching Kernel Source
        : "${KERNELMODULE:?must be set}"
        : "${COMMONKERNELFOLDER:?must be set}"
        # Normalize Sublevel to a Non-Negative Integer
        SUBLEVELVALUE="${SUBLEVEL:-0}"
        [[ "$SUBLEVELVALUE" =~ ^[0-9]+$ ]] || SUBLEVELVALUE=0
        # Print standardized patch operation logs.
        logpatch() {
          printf '[%s] %s | %s\n' "$1" "$2" "$3"
        }

        # Require Source File When Patch Cannot Work Without it
        needfile() {
          [[ -f "$1" ]] || {
            echo "⚠️ Required File Missing: $1" >&2
            return 1
          }
        }

        # Check Whether File Contains Exact Literal String
        hastext() {
          grep -Fq -- "$2" "$1"
        }

        # Insert Line After the First Regex-Matching Line
        # Skip Insertion When Exact Line Already Exists
        insertfirstafter() {
          local file="$1" anchor="$2" line="$3" tmp
          needfile "$file"
          if hastext "$file" "$line"; then
            return 0
          fi

          grep -Eq -- "$anchor" "$file" || {
            echo "⚠️ Anchor Not Found in $file: $anchor" >&2
            return 1
          }
          tmp="${file}.fakepatch.tmp"
          awk -v anchor="$anchor" -v new="$line" '
            {
              print
              if (!done && $0 ~ anchor) {
                print new
                done=1
              }
            }
            END {
              if (!done) exit 3
            }
          ' "$file" > "$tmp" || {
            rm -f "$tmp"
            echo "⚠️ Failed to Insert Into $file" >&2
            return 1
          }
          mv "$tmp" "$file"
        }
        # Insert Line Before the First Regex-Matching Line
        # Skip Insertion When Exact Line Already Exists
        insertfirstbefore() {
          local file="$1" anchor="$2" line="$3" tmp
          needfile "$file"
          if hastext "$file" "$line"; then
            return 0
          fi

          grep -Eq -- "$anchor" "$file" || {
            echo "⚠️ Anchor Not Found in $file: $anchor" >&2
            return 1
          }
          tmp="${file}.fakepatch.tmp"
          awk -v anchor="$anchor" -v new="$line" '
            $0 ~ anchor && !done {
              print new
              done=1
            }
            {
              print
            }
            END {
              if (!done) exit 3
            }
          ' "$file" > "$tmp" || {
            rm -f "$tmp"
            echo "⚠️ Failed to Insert Into $file" >&2
            return 1
          }
          mv "$tmp" "$file"
        }
        # Delete Source Lines Matching a Perl Regular Expression
        # Missing Optional Files are Intentionally Ignored
        deletematchinglines() {
          local file="$1" regex="$2"
          [[ -f "$file" ]] || return 0
          MATCHREGEX="$regex" perl -ni -e \
            'print unless /$ENV{MATCHREGEX}/' "$file"
        }
        # Replace Regex Matches Using an Environment-Provided Pattern
        # Avoids Embedding Dynamic Patterns Directly in Perl Code
        replaceperl() {
          local file="$1" regex="$2" replacement="$3"
          needfile "$file"
          MATCHREGEX="$regex" REPLACEMENT="$replacement" \
            perl -pi -e \
              's/$ENV{MATCHREGEX}/$ENV{REPLACEMENT}/g' "$file"
        }
        # Apply INOTIFY FDINFO Compatibility Patch
        # Older Kernel Implementations May Expose Ignored Mask Separately
        applyfdinfo() {
          local file="$1"
          needfile "$file"
          # Avoid Adding Helper More Than Once
          if hastext "$file" 'inotify_mark_user_mask('; then
            logpatch SKIP "$file" '⛔ FDINFO Patch Already Applied'
            return
          fi

          # Fail Rather Than Silently Modifying an Unexpected Source Layout
          hastext "$file" 'mask, mark.ignored_mask' || {
            echo "⚠️ Expected FDINFO Expression Missing: $file" >&2
            return 1
          }

          # Remove Legacy Mask Declaration Comment Block
          perl -0pi -e \
            's/^[ \t]*\/\*\n.*?^[ \t]*u32 mask = mark->mask & IN_ALL_EVENTS;\n//ms' \
            "$file"

          # Use a Helper for the User-Visible Event Mask and Normalize Logging
          perl -pi -e \
            's/\bmask,\s*mark\.ignored_mask/inotify_mark_user_mask(mark)/g; s/ignored_mask:%x/ignored_mask:0/g' \
            "$file"

          # Define Helper Immediately Before INOTIFY FDINFO
          if ! grep -Fq 'static inline u32 inotify_mark_user_mask(' "$file"; then
            perl -0pi -e \
              's/^(static void inotify_fdinfo\(struct seq_file \*m, struct fsnotify_mark \*mark\)\n)/static inline u32 inotify_mark_user_mask(struct fsnotify_mark *mark)\n{\n\treturn mark->mask \& IN_ALL_EVENTS;\n}\n\n$1/m' \
              "$file"
          fi

          # Confirm Compatibility Helper was Inserted Successfully
          hastext "$file" 'inotify_mark_user_mask(' || {
            echo "⚠️ Could Not Apply FDINFO Patch to $file" >&2
            return 1
          }
          logpatch APPLY "$file" '🛄 Applied INOTIFY FDINFO Compatibility Patch'
        }

        # Revert INOTIFY FDINFO Compatibility Patch
        revertfdinfo() {
          local file="$1"
          [[ -f "$file" ]] || {
            logpatch SKIP "$file" '⚠️ File Missing'
            return
          }

          # Nothing to Restore if Neither Marker Exists
          if ! hastext "$file" 'inotify_mark_user_mask(' &&
             ! hastext "$file" 'ignored_mask:0'; then
            return
          fi

          # Restore Original Expression and Diagnostic Format
          perl -pi -e \
            's/inotify_mark_user_mask\(mark\)/mask/g; s/ignored_mask:0/ignored_mask:%x/g' \
            "$file"
          # Remove Helper Definition
          perl -0pi -e \
            's/^static inline u32 inotify_mark_user_mask\(struct fsnotify_mark \*mark\)\n\{\n.*?^\}\n\n?//ms' \
            "$file"
          logpatch REVERT "$file" '♻️ Restored Original FDINFO MASK Handling'
        }

        # Apply Kernel-Version-Specific Compatibility Changes
        fakepatchapply() {
          case "$KERNELMODULE" in
            # Android 12 / Linux 5.10:
            # Normalize THIS-LEN and Apply Older FDINFO Compatibility Fix
            android12-5.10)
              if (( SUBLEVELVALUE <= 43 )); then
                FILE="$COMMONKERNELFOLDER/fs/proc/base.c"
                if [[ -f "$FILE" ]]; then
                  perl -pi -e \
                    's/(?:int|size_t)\s+this_len\s*=\s*min_t\s*\(\s*(?:int|size_t)\s*,/size_t this_len = min_t(size_t,/' \
                    "$FILE"
                  logpatch APPLY "$FILE" '♻️ Normalized THIS-LEN MIN-T to SIZE-T'
                fi
              fi

              (( SUBLEVELVALUE > 117 )) || \
                applyfdinfo "$COMMONKERNELFOLDER/fs/notify/fdinfo.c"
              ;;
            # Android 13 / Linux 5.10:
            # Apply FDINFO Compatibility to Older Sublevels
            android13-5.10)
              (( SUBLEVELVALUE > 107 )) || \
                applyfdinfo "$COMMONKERNELFOLDER/fs/notify/fdinfo.c"
              ;;
            # Android 13 / Linux 5.15:
            # Add Mount IDMapping Headers and Remove Obsolete Includes
            # For Newer Sublevel Compatibility
            android13-5.15)
              if (( SUBLEVELVALUE <= 41 )); then
                insertfirstafter "$COMMONKERNELFOLDER/fs/namespace.c" \
                  '^#include <linux/shmem_fs\.h>$' \
                  '#include <linux/mnt_idmapping.h>'
                insertfirstafter "$COMMONKERNELFOLDER/fs/open.c" \
                  '^#include <linux/compat\.h>$' \
                  '#include <linux/mnt_idmapping.h>'
                applyfdinfo "$COMMONKERNELFOLDER/fs/notify/fdinfo.c"
              fi

              if (( SUBLEVELVALUE >= 123 )); then
                deletematchinglines "$COMMONKERNELFOLDER/mm/memory.c" \
                  '^#include <linux/swap_slots\.h>$'
              fi

              if (( SUBLEVELVALUE >= 197 )); then
                deletematchinglines "$COMMONKERNELFOLDER/fs/namespace.c" \
                  '^#include <trace/hooks/blk\.h>$'
              fi

              if (( SUBLEVELVALUE >= 206 )); then
                deletematchinglines "$COMMONKERNELFOLDER/fs/proc/task_mmu.c" \
                  '^#include <trace/hooks/mm\.h>$'
              fi
              ;;
            # Android 14 / Linux 6.1:
            # Add Trace and DMA-BUF Headers on Older Sublevels
            # Remove Obsolete Trace-Hook Includes on Newer Sublevels
            android14-6.1)
              if (( SUBLEVELVALUE <= 25 )); then
                insertfirstafter "$COMMONKERNELFOLDER/fs/proc/base.c" \
                  '^#include <trace/events/oom\.h>$' \
                  '#include <trace/hooks/sched.h>'
              fi

              if (( SUBLEVELVALUE <= 141 )); then
                insertfirstafter "$COMMONKERNELFOLDER/fs/proc/base.c" \
                  '^#include <linux/cpufreq_times\.h>$' \
                  '#include <linux/dma-buf.h>'
              fi

              if (( SUBLEVELVALUE >= 157 )); then
                deletematchinglines "$COMMONKERNELFOLDER/fs/namespace.c" \
                  '^#include <trace/hooks/blk\.h>$'
                perl -0pi -e \
                  's/^#include <trace\/hooks\/fs\.h>\n[^\n]*\n//m' \
                  "$COMMONKERNELFOLDER/fs/super.c"
              fi
              ;;
            # Android 15 / Linux 6.6:
            # Adapt SMAPS VMA Tracking and Pagemap Declarations on Older
            # Sublevels, Then Add Required ZSWAP and DMA-BUF Headers
            android15-6.6)
              if (( SUBLEVELVALUE <= 30 )); then
                TASK="$COMMONKERNELFOLDER/fs/proc/task_mmu.c"
                NS="$COMMONKERNELFOLDER/fs/namespace.c"
                needfile "$TASK"
                needfile "$NS"
                # Use Declaration as the Marker for Patch Group
                if ! hastext "$TASK" \
                  'unsigned int nr_subpages = __PAGE_SIZE / PAGE_SIZE;'; then
                  # Update LAST-VMA-END After Gathering SMAPS Statistics
                  # Add Braces to VMA-END Check for Safe Statement Grouping
                  if ! hastext "$TASK" 'smap_gather_stats(vma, &mss, last_vma_end);'; then
                    echo "⚠️ Expected SMAPS Anchor Missing: $TASK" >&2
                    return 1
                  fi

                  perl -0pi -e \
                    's/(smap_gather_stats\(vma, &mss, last_vma_end\);)/$1\n\t\t\t\tlast_vma_end = vma->vm_end;/s' \
                    "$TASK"
                  perl -0pi -e \
                    's/if\s*\(vma->vm_end > last_vma_end\)\n(\s*)last_vma_end = vma->vm_end;/if (vma->vm_end > last_vma_end) {\n$1\tlast_vma_end = vma->vm_end;\n$1}/s' \
                    "$TASK"
                  # Add Filesystem Trace Hook Required by Patch Set
                  insertfirstafter "$NS" \
                    '#include <trace/hooks/blk\.h>' \
                    '#include <trace/hooks/fs.h>'
                  # Insert Pagemap Variables Beside the Existing Declarations
                  insertfirstafter "$TASK" \
                    'int ret = 0, copied = 0;' \
                    $'\tunsigned int nr_subpages = __PAGE_SIZE / PAGE_SIZE;'
                  insertfirstafter "$TASK" \
                    'unsigned int nr_subpages = __PAGE_SIZE / PAGE_SIZE;' \
                    $'\tpagemap_entry_t *res = NULL;'
                fi
              fi

              # Older 6.6 Sublevels May Require Zswap Header
              if (( SUBLEVELVALUE <= 57 )); then
                insertfirstafter "$COMMONKERNELFOLDER/mm/memory.c" \
                  '^#include <linux/sched/sysctl\.h>$' \
                  '#include <linux/zswap.h>'
              fi

              # Older 6.6 Sublevels May Require DMA-BUF Header
              if (( SUBLEVELVALUE <= 92 )); then
                insertfirstafter "$COMMONKERNELFOLDER/fs/proc/base.c" \
                  '^#include <linux/cpufreq_times\.h>$' \
                  '#include <linux/dma-buf.h>'
              fi
              ;;

            # Android 16 / Linux 6.12:
            # Remove an Obsolete DMA-BUF Include and Adapt VMA Page API
            android16-6.12)
              if (( SUBLEVELVALUE >= 58 )); then
                deletematchinglines "$COMMONKERNELFOLDER/fs/exec.c" \
                  '^#include <linux/dma-buf\.h>$'
              fi

              if (( SUBLEVELVALUE >= 69 )); then
                replaceperl "$COMMONKERNELFOLDER/fs/proc/task_mmu.c" \
                  '\bvma_data_pages\b' 'vma_pages'
              fi
              ;;
          esac
        }
        # Apply Compatibility Fixups After the Primary Patch Stage
        # These Changes Accommodate APIs That differ Between Kernel Versions
        fakepatchpostfix() {
          TASK="$COMMONKERNELFOLDER/fs/proc/task_mmu.c"
          if [[ -f "$TASK" ]]; then
            # Supply a Fallback VMA PAD START Definition When Source
            # References it But Lacks Corresponding Header or Definition
            if hastext "$TASK" 'VMA_PAD_START(' &&
               ! grep -Eq \
                 '#include <linux/pgsize_migration(_inline)?\.h>|^[[:space:]]*#define[[:space:]]+VMA_PAD_START' \
                 "$TASK"; then
              perl -0pi -e \
                's/\A([^\n]*\n)/$1#ifndef VMA_PAD_START\n#define VMA_PAD_START(vma) ((vma)->vm_end)\n#endif\n/s' \
                "$TASK"
            fi

            # Supply Filemap Fixup Helper When Source References it
            # But Does Not Provide its Inline Implementation
            if hastext "$TASK" '__fold_filemap_fixup_entry(' &&
               ! grep -Eq \
                 'static[[:space:]]+inline[[:space:]]+void[[:space:]]+__fold_filemap_fixup_entry' \
                 "$TASK"; then
              HEADER="$COMMONKERNELFOLDER/include/linux/page_size_compat.h"
              # Prefer Existing Compatibility Header When it Defines
              # Required Helper
              if [[ -f "$HEADER" ]] &&
                 hastext "$HEADER" '__fold_filemap_fixup_entry'; then
                grep -Fq '#include <linux/page_size_compat.h>' "$TASK" ||
                  insertfirstafter "$TASK" '^#include ' \
                    '#include <linux/page_size_compat.h>'
              else
                # Otherwise insert a guarded fallback after the include block.
                perl -0pi -e \
                  's/((?:^#include[^\n]*\n)+)/$1#ifndef __fold_filemap_fixup_entry\nstatic inline void __fold_filemap_fixup_entry(struct vma_iterator *iter, unsigned long *end) { }\n#endif \/\* __fold_filemap_fixup_entry \*\/\n/s' \
                  "$TASK"
              fi
            fi
          fi

          # Older Android 12 / 13 Kernels Use a Three-Argument SET NAMEIDATA()
          if [[ "$KERNELMODULE" == android12-5.10 ||
                "$KERNELMODULE" == android13-5.10 ]]; then
            FILE="$COMMONKERNELFOLDER/fs/namei.c"
            if [[ -f "$FILE" ]]; then
              replaceperl "$FILE" \
                'set_nameidata\(nd, old_dfd, fake_filename, NULL\)' \
                'set_nameidata(nd, old_dfd, fake_filename)'
            fi
          fi

          # Android 16 / Linux 6.12 May Use Two-Argument GETNAME-FLAGS()
          if [[ "$KERNELMODULE" == android16-6.12 ]]; then
            FILE="$COMMONKERNELFOLDER/fs/open.c"
            if [[ -f "$FILE" ]]; then
              replaceperl "$FILE" \
                'getname_flags\(filename, lookup_flags, NULL\)' \
                'getname_flags(filename, lookup_flags)'
            fi
          fi

          logpatch POSTFIX "$KERNELMODULE" \
            '🎉 Post-Patch Compatibility Fixups Complete'
        }
        # Revert Supported Changes For Each Kernel Family
        # Revert Should be Run Against Same Source Version Used For Apply
        fakepatchrevert() {
          case "$KERNELMODULE" in
            # Restore Older THIS-LEN Declaration and FDINFO Implementation
            android12-5.10)
              if (( SUBLEVELVALUE <= 43 )); then
                perl -pi -e \
                  's/^size_t this_len = min_t\(size_t, count, PAGE_SIZE\);$/int this_len = min_t(int, count, PAGE_SIZE);/' \
                  "$COMMONKERNELFOLDER/fs/proc/base.c"
              fi

              (( SUBLEVELVALUE > 117 )) || \
                revertfdinfo "$COMMONKERNELFOLDER/fs/notify/fdinfo.c"
              ;;
            # Restore FDINFO Implementation for Older Android 13 Kernels
            android13-5.10)
              (( SUBLEVELVALUE > 107 )) || \
                revertfdinfo "$COMMONKERNELFOLDER/fs/notify/fdinfo.c"
              ;;
            # Restore Android 13 / Linux 5.15 Header and SUSFS Compatibility
            android13-5.15)
              if (( SUBLEVELVALUE <= 41 )); then
                deletematchinglines "$COMMONKERNELFOLDER/fs/namespace.c" \
                  '^#include <linux/mnt_idmapping\.h>$'
                deletematchinglines "$COMMONKERNELFOLDER/fs/open.c" \
                  '^#include <linux/mnt_idmapping\.h>$'
                # Restore Original User-Namespace Arguments in SUSFS
                FILE="$COMMONKERNELFOLDER/fs/susfs.c"
                if [[ -f "$FILE" ]]; then
                  replaceperl "$FILE" \
                    'i_uid_into_mnt\(i_user_ns\(&fi->inode\), &fi->inode\)\.val' \
                    'i_uid_into_mnt(&init_user_ns, &fi->inode).val'
                  replaceperl "$FILE" \
                    'i_uid_into_mnt\(i_user_ns\(inode\), inode\)\.val' \
                    'i_uid_into_mnt(&init_user_ns, inode).val'
                fi

                revertfdinfo "$COMMONKERNELFOLDER/fs/notify/fdinfo.c"
              fi

              # Restore SWAPSLOTS Header for Newer Sublevels
              if (( SUBLEVELVALUE >= 123 )); then
                FILE="$COMMONKERNELFOLDER/mm/memory.c"
                grep -Fq '#include <linux/swap_slots.h>' "$FILE" ||
                  insertfirstbefore "$FILE" \
                    '^#ifdef CONFIG_KSU_KSUFS_SUS_MAP|^#ifdef CONFIG_KSU_SUSFS_SUS_MAP' \
                    '#include <linux/swap_slots.h>'
              fi

              # Restore Block Trace Hook for Newer Sublevels
              if (( SUBLEVELVALUE >= 197 )); then
                FILE="$COMMONKERNELFOLDER/fs/namespace.c"
                grep -Fq '#include <trace/hooks/blk.h>' "$FILE" ||
                  insertfirstafter "$FILE" \
                    '^#include "internal\.h"$' \
                    '#include <trace/hooks/blk.h>'
              fi

              # Restore MM Trace Hook for Newer Sublevels
              if (( SUBLEVELVALUE >= 206 )); then
                FILE="$COMMONKERNELFOLDER/fs/proc/task_mmu.c"
                grep -Fq '#include <trace/hooks/mm.h>' "$FILE" ||
                  insertfirstafter "$FILE" \
                    '^#include <linux/pkeys\.h>$' \
                    '#include <trace/hooks/mm.h>'
              fi
              ;;
            # Restore Android 14 / Linux 6.1 Header Changes
            android14-6.1)
              if (( SUBLEVELVALUE <= 25 )); then
                deletematchinglines "$COMMONKERNELFOLDER/fs/proc/base.c" \
                  '^#include <trace/hooks/sched\.h>$'
              fi

              if (( SUBLEVELVALUE <= 141 )); then
                deletematchinglines "$COMMONKERNELFOLDER/fs/proc/base.c" \
                  '^#include <linux/dma-buf\.h>$'
              fi

              # Re-Add Trace Hooks Removed by Apply Stage
              if (( SUBLEVELVALUE >= 157 )); then
                FILE="$COMMONKERNELFOLDER/fs/namespace.c"
                grep -Fq '#include <trace/hooks/blk.h>' "$FILE" ||
                  insertfirstafter "$FILE" \
                    '^#include "internal\.h"$' \
                    '#include <trace/hooks/blk.h>'
                FILE="$COMMONKERNELFOLDER/fs/super.c"
                grep -Fq '#include <trace/hooks/fs.h>' "$FILE" ||
                  insertfirstafter "$FILE" \
                    '^#include "internal\.h"$' \
                    '#include <trace/hooks/fs.h>'
              fi
              ;;
            # Remove Android 15 / Linux 6.6 SMAPS and Header Compatibility Edits
            android15-6.6)
              if (( SUBLEVELVALUE <= 30 )); then
                TASK="$COMMONKERNELFOLDER/fs/proc/task_mmu.c"
                NS="$COMMONKERNELFOLDER/fs/namespace.c"
                deletematchinglines "$NS" \
                  '^#include <trace/hooks/fs\.h>$'
                deletematchinglines "$TASK" \
                  '^[[:space:]]*unsigned int nr_subpages = __PAGE_SIZE / PAGE_SIZE;$'
                deletematchinglines "$TASK" \
                  '^[[:space:]]*pagemap_entry_t \*res = NULL;$'
                deletematchinglines "$TASK" \
                  '^[[:space:]]*last_vma_end = vma->vm_end;$'
                # Restore Original Unbraced VMA-END Condition
                perl -0pi -e \
                  's/if\s*\(vma->vm_end > last_vma_end\)\s*\{/if (vma->vm_end > last_vma_end)/g; s/(if \(vma->vm_end > last_vma_end\)\n[^\n]*\n)[ \t]*\}\n/$1/s' \
                  "$TASK"
              fi

              # Remove Headers Introduced For Older Sublevels
              if (( SUBLEVELVALUE <= 57 )); then
                deletematchinglines "$COMMONKERNELFOLDER/mm/memory.c" \
                  '^#include <linux/zswap\.h>$'
              fi

              if (( SUBLEVELVALUE <= 92 )); then
                deletematchinglines "$COMMONKERNELFOLDER/fs/proc/base.c" \
                  '^#include <linux/dma-buf\.h>$'
              fi
              ;;
            # Restore Android 16 / Linux 6.12 API Compatibility Changes
            android16-6.12)
              if (( SUBLEVELVALUE >= 58 )); then
                FILE="$COMMONKERNELFOLDER/fs/exec.c"
                grep -Fq '#include <linux/dma-buf.h>' "$FILE" ||
                  insertfirstafter "$FILE" '^#include ' \
                    '#include <linux/dma-buf.h>'
              fi

              if (( SUBLEVELVALUE >= 69 )); then
                replaceperl "$COMMONKERNELFOLDER/fs/proc/task_mmu.c" \
                  '\bvma_pages\b' 'vma_data_pages'
              fi
              ;;
          esac
          logpatch REVERT "$KERNELMODULE" '🎉 Revert Operations Complete'
        }
        # Dispatch One or More Requested Operations
        runfakepatch() {
          local mode
          local modes="${1:-Apply}"
          IFS=',' read -ra MODELIST <<< "$modes"
          for mode in "${MODELIST[@]}"; do
            case "$mode" in
              Apply)
                fakepatchapply
                ;;
              PostFix)
                fakepatchpostfix
                ;;
              Revert)
                fakepatchrevert
                ;;
              *)
                echo "⚠️ Unsupported FakePatches Mode: $mode" >&2
                return 2
                ;;
            esac
            echo "🎉 FakePatches: $mode Completed (Kernel Base $KERNELMODULE, Sublevel $SUBLEVELVALUE)"
          done
        }        
        # Run Selected Operation; Default to Apply When Unset
        runfakepatch "${FAKEPATCHMODE:-Apply}"
