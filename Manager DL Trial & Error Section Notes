- name: Download Selected KSU Meta Manager APK
  continue-on-error: true
  env:
    GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
  run: |
    set -uo pipefail   # Treat Unset Variables as Errors; Pipeline Fails if Any Command Fails
                       # Note: Won't use `-e` Globally so the Script can Continue on Failure Sections

    # ==============================
    # Inputs from Previous Steps
    # ==============================
    REPO="${{ steps.manager.outputs.KSU_REPO }}"
    BRANCH="${{ steps.manager.outputs.MANAGER_BRANCH }}"
    ARTIFACT="${{ steps.manager.outputs.MANAGER_ARTIFACT }}"

    echo "================================="
    echo "KSU Manager Downloader"
    echo "---------------------------------"
    echo "Repository: $REPO"
    echo "Branch:     $BRANCH"
    echo "Artifact:   $ARTIFACT"
    echo "================================="

    # ==============================
    # Prepare Directory for APK
    # ==============================
    mkdir -p ./AnyKernel3 || true

    # ==============================
    # Get Latest Successful Workflow Run
    # ==============================
    run_id=$(gh api \
      "repos/$REPO/actions/runs?branch=$BRANCH&status=success&per_page=1" \
      --jq '.workflow_runs[0].id' 2>/dev/null || echo "")

    if [[ -z "${run_id:-}" || "$run_id" == "null" ]]; then
      echo "⚠️ No Successful Workflow Run Found 🧹 Skipping Download"
    else
      echo "📌 Found Run ID: $run_id"

      # ==============================
      # Get Artifact URL (Continue if Not Found)
      # ==============================
      artifact_url=$(gh api \
        "repos/$REPO/actions/runs/$run_id/artifacts" \
        --jq ".artifacts[] | select(.name == \"$ARTIFACT\") | .archive_download_url" \
        2>/dev/null | head -n1 || echo "")

      if [[ -z "${artifact_url:-}" ]]; then
        echo "⚠️ Artifact(s) '$ARTIFACT' Not Found 🧹 Skipping Download"
      else
        echo "📩 Downloading Artifact(s)..."
        curl -fL -H "Authorization: token $GITHUB_TOKEN" -o manager.zip "$artifact_url" || echo "⚠️ Download Failed, Continuing..."

        echo "📃 Extracting APK..."
        unzip -o -j manager.zip "*.apk" -d ./AnyKernel3/ || echo "No APK found in zip, continuing..."
        rm -f manager.zip || true

        echo "✔️ KSU Meta Manager APK Download Complete"
      fi
    fi

    echo "🎉 Script Finished 📌 Sections that Failed were Skipped"
