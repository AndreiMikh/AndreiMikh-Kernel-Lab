
    - name: 📦 Prepare Release Build Files
      if: ${{ steps.buildprofile.outputs.gitrelease == 'Enabled' }}
      shell: bash
      run: |
        set -Eeuo pipefail

        WS="${GITHUB_WORKSPACE}"
        RELEASEINPUT="${WS}/Release-Output"

        echo "📦 Preparing Release Build Files..."
        echo ""

        # Create a Clean Release Staging Directory
        rm -rf "$RELEASEINPUT"
        mkdir -p \
          "${RELEASEINPUT}/AnyKernel3" \
          "${RELEASEINPUT}/manager"

        # Verify AnyKernel3 Source Directory
        [[ -d "${WS}/AnyKernel3" ]] || {
          echo "⛔ AnyKernel3 Directory Missing"
          echo "   ${WS}/AnyKernel3"
          exit 1
        }

        # Copy Complete AnyKernel3 Tree
        cp -a \
          "${WS}/AnyKernel3/." \
          "${RELEASEINPUT}/AnyKernel3/"

        # Resolve Root Manager APK Directory Produced by the Build
        MANAGERAPKDIR="${{ steps.root-engine-apk.outputs.managerapkdir }}"
        [[ -d "$MANAGERAPKDIR" ]] || {
          echo "⛔ Root Manager APK Directory Missing"
          echo "   ${MANAGERAPKDIR}"
          exit 1
        }

        # Ensure at Least One Manager APK Exists
        compgen -G "${MANAGERAPKDIR}/*.apk" > /dev/null || {
          echo "⛔ Root Manager APK Missing"
          echo "   Directory: ${MANAGERAPKDIR}"
          exit 1
        }

        # Copy All Generated Manager APKs
        cp -a \
          "${MANAGERAPKDIR}/"*.apk \
          "${RELEASEINPUT}/manager/"
        echo "📁 Release Artifact Contents:"
        find "$RELEASEINPUT" \
          -type f \
          -printf '  %P\n'

        echo ""
        echo "🎉 Release Build Files Prepared"

    - name: 📦 Prepare NoMount Userspace
      if: ${{ inputs.NOMOUNT != 'None' }}
      shell: bash
      run: |
        set -Eeuo pipefail

        WS="${GITHUB_WORKSPACE}"

        NOMOUNTSOURCE="${WS}/kernel_workspace/nomount"
        NOMOUNTMODULE="${NOMOUNTSOURCE}/module"
        NOMOUNTBIN="${NOMOUNTSOURCE}/nomount-bin"

        NOMOUNTMODULEDIR="${WS}/nomount-userspace"
        NOMOUNTOUTDIR="${WS}/output"

        echo "📦 Preparing NoMount Userspace..."
        echo ""

        echo "📂 NoMount Source : ${NOMOUNTSOURCE}"
        echo "📂 Module         : ${NOMOUNTMODULE}"
        echo "📂 Binary         : ${NOMOUNTBIN}"
        echo "📂 Output         : ${NOMOUNTOUTDIR}"
        echo ""

        # Verify NoMount Module
        [[ -d "$NOMOUNTMODULE" ]] || {
          echo "⛔ NoMount Module Directory Missing"
          echo "   ${NOMOUNTMODULE}"
          exit 1
        }
        [[ -f "${NOMOUNTMODULE}/module.prop" ]] || {
          echo "⛔ NoMount module.prop Missing"
          echo "   ${NOMOUNTMODULE}/module.prop"
          exit 1
        }

        # Verify Compiled Userspace Binaries
        [[ -x "${NOMOUNTBIN}/nm-arm64" ]] || {
          echo "⛔ NoMount ARM64 Binary Missing"
          echo "   ${NOMOUNTBIN}/nm-arm64"
          exit 1
        }
        [[ -x "${NOMOUNTBIN}/nm-arm" ]] || {
          echo "⛔ NoMount ARM Binary Missing"
          echo "   ${NOMOUNTBIN}/nm-arm"
          exit 1
        }

        # Verify Source Commit Metadata
        [[ -f "${NOMOUNTBIN}/nm-commit-src" ]] || {
          echo "⛔ NoMount Source Commit Missing"
          echo "   ${NOMOUNTBIN}/nm-commit-src"
          exit 1
        }

        NOMOUNTCOMMIT="$(
          tr -d '[:space:]' \
            < "${NOMOUNTBIN}/nm-commit-src"
        )"

        [[ "$NOMOUNTCOMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || {
          echo "⛔ Invalid NoMount Commit"
          echo "   ${NOMOUNTCOMMIT}"
          exit 1
        }

        echo "📌 NoMount Commit : ${NOMOUNTCOMMIT}"
        echo ""

        # Create Clean Staging Directories
        rm -rf "$NOMOUNTMODULEDIR"
        rm -rf "$NOMOUNTOUTDIR"
        mkdir -p \
          "${NOMOUNTMODULEDIR}/bin" \
          "$NOMOUNTOUTDIR"

        # Copy Original NoMount Module Contents
        cp -a \
          "${NOMOUNTMODULE}/." \
          "$NOMOUNTMODULEDIR/"

        # Install ARM64 Userspace Binary
        install -m 0755 \
          "${NOMOUNTBIN}/nm-arm64" \
          "${NOMOUNTMODULEDIR}/bin/nm-arm64"

        # Install ARM Userspace Binary
        install -m 0755 \
          "${NOMOUNTBIN}/nm-arm" \
          "${NOMOUNTMODULEDIR}/bin/nm-arm"

        # Store Exact Source Commit in the Package
        printf '%s\n' "$NOMOUNTCOMMIT" \
          > "${NOMOUNTMODULEDIR}/nm-commit-src"

        # Normalize Module Version Code When Module.prop Defines it
        if grep -q '^versionCode=' \
            "${NOMOUNTMODULEDIR}/module.prop"; then
          sed -i \
            's/^versionCode=.*/versionCode=1/' \
            "${NOMOUNTMODULEDIR}/module.prop"
        fi

        NOMOUNTZIP="${NOMOUNTOUTDIR}/NoMount-${NOMOUNTCOMMIT}.zip"
        rm -f "$NOMOUNTZIP"
        rm -f "${NOMOUNTZIP}.sha256"

        # Create NoMount Userspace ZIP
        echo "📦 Creating NoMount Userspace..."
        (
          cd "$NOMOUNTMODULEDIR"
          zip -qr \
            "$NOMOUNTZIP" \
            .
        )

        # Generate SHA-256 Checksum
        sha256sum "$NOMOUNTZIP" \
          > "${NOMOUNTZIP}.sha256"

        # Verify Generated Files
        [[ -s "$NOMOUNTZIP" ]] || {
          echo "⛔ NoMount Userspace ZIP Was Not Created"
          exit 1
        }
        [[ -s "${NOMOUNTZIP}.sha256" ]] || {
          echo "⛔ NoMount Userspace SHA-256 Was Not Created"
          exit 1
        }

        echo ""
        echo "📦 ZIP     : ${NOMOUNTZIP}"
        echo "🔐 SHA-256 : ${NOMOUNTZIP}.sha256"
        echo ""

        # Validate ZIP Archive
        echo "🔎 Validating NoMount ZIP..."
        unzip -tq \
          "$NOMOUNTZIP"
        echo "✔️ ZIP Validation Passed"

        # Validate Generated Checksum
        echo "🔐 Verifying SHA-256..."
        (
          cd "$NOMOUNTOUTDIR"
          sha256sum -c \
            "$(basename "${NOMOUNTZIP}.sha256")"
        )

        echo "✔️ SHA-256 Verification Passed"

        # Display Final Package Contents
        echo "📁 NoMount Package Contents:"
        unzip -l "$NOMOUNTZIP"

        echo ""
        echo "🎉 NoMount Userspace Prepared Successfully"

    - name: 📤 Upload Kernel Release Files
      if: ${{ steps.buildprofile.outputs.gitrelease == 'Enabled' }}
      uses: actions/upload-artifact@v7
      with:
        name: Kernel-Release-Files
        path: ${{ github.workspace }}/Release-Output
        if-no-files-found: error
        compression-level: 0

    - name: 📤 Upload NoMount Userspace
      if: ${{ inputs.NOMOUNT != 'None' }}
      uses: actions/upload-artifact@v7
      with:
        name: NoMount-Userspace-${{ steps.manifest.outputs.manifestbasefile }}
        path: |
          ${{ github.workspace }}/output/NoMount-*.zip
          ${{ github.workspace }}/output/NoMount-*.zip.sha256
        if-no-files-found: error
        compression-level: 0


release:
  name: Create GitHub Release
  needs:
    - kernel-build
  if: >-
    ${{ needs.kernel-build.result == 'success' &&
        needs.kernel-build.outputs.gitrelease == 'Enabled' }}
  runs-on: ubuntu-latest
  steps:

    # Download the AnyKernel3 and manager release files.
    - name: 📥 Download Kernel Release Files
      uses: actions/download-artifact@v7
      with:
        name: Kernel-Release-Files
        path: Release-Output
        merge-multiple: false

    - name: 📥 Download NoMount Userspace
      if: ${{ inputs.NOMOUNT != 'None' }}
      uses: actions/download-artifact@v7
      with:
        name: NoMount-Userspace-${{ needs.kernel-build.outputs.manifestbasefile }}
        path: nomount-userspace
        merge-multiple: false

    - name: 📦 Create Zip Package
      shell: bash
      env:
        FULLVERSION: ${{ needs.kernel-build.outputs.kernelversion }}
        KSUVERSION: ${{ needs.kernel-build.outputs.ksuversion }}
        MANIFESTBASEFILE: ${{ needs.kernel-build.outputs.manifestbasefile }}
        SUFFIX: ${{ needs.kernel-build.outputs.suffix }}
      run: |
        set -Eeuo pipefail

        echo "📋 Build Information"
        echo "🧠 Kernel Packaging Stage"
        echo "Base       : ${MANIFESTBASEFILE}"
        echo "Kernel     : ${FULLVERSION}"
        echo "Root       : ${KSUVERSION}"
        echo ""

        ANYKERNEL3DIR="${GITHUB_WORKSPACE}/Release-Output/AnyKernel3"
        ANYKERNEL3ZIP="${FULLVERSION}-${KSUVERSION}-${MANIFESTBASEFILE}-${SUFFIX}.zip"

        # Verify AnyKernel3 Source
        [[ -d "$ANYKERNEL3DIR" ]] || {
          echo "⛔ AnyKernel3 Directory Missing"
          echo "   ${ANYKERNEL3DIR}"
          exit 1
        }

        # Verify Source Tree Contains Files
        [[ -n "$(find "$ANYKERNEL3DIR" \
          -mindepth 1 \
          -print \
          -quit)" ]] || {
          echo "⛔ AnyKernel3 Directory Is Empty"
          exit 1
        }

        echo "📦 Creating AnyKernel3 ZIP..."
        (
          cd "$ANYKERNEL3DIR"
          zip -qr \
            "${GITHUB_WORKSPACE}/${ANYKERNEL3ZIP}" \
            .
        )

        # Verify Final ZIP Exists and is Not Empty
        [[ -s "${GITHUB_WORKSPACE}/${ANYKERNEL3ZIP}" ]] || {
          echo "⛔ AnyKernel3 ZIP Was Not Created"
          exit 1
        }

        echo "📦 Package : ${ANYKERNEL3ZIP}"
        echo "📏 Size    : $(du -h \
          "${GITHUB_WORKSPACE}/${ANYKERNEL3ZIP}" |
          awk '{print $1}')"
        echo ""

        # Validate AnyKernel3 Archive
        echo "🔎 Validating AnyKernel3 ZIP..."
        unzip -tq \
          "${GITHUB_WORKSPACE}/${ANYKERNEL3ZIP}"
        echo "✔️ AnyKernel3 ZIP Validation Passed"

        # Export Final ZIP Path for Later Steps
        echo "ANYKERNEL3ZIP=${GITHUB_WORKSPACE}/${ANYKERNEL3ZIP}" \
          >> "$GITHUB_ENV"

    - name: 🔎 Verify Release Files
      shell: bash
      run: |
        set -Eeuo pipefail

        echo "📂 Release Output:"
        find Release-Output \
          -type f \
          -printf '  %P\n'

        # Verify that at Least One Root Manager APK Exists
        [[ -n "$(find Release-Output/manager \
          -type f \
          -name '*.apk' \
          -print \
          -quit 2>/dev/null)" ]] || {
          echo "⛔ Root Manager APK Missing"
          exit 1
        }

        # Verify NoMount Assets When NoMount is Enabled
        if [[ "${{ inputs.NOMOUNT }}" != "None" ]]; then
          [[ -d "nomount-userspace" ]] || {
            echo "⛔ NoMount Userspace Directory Missing"
            exit 1
          }

          echo ""
          echo "📂 NoMount Userspace:"
          find nomount-userspace \
            -type f \
            -printf '  %P\n'
          [[ -n "$(find nomount-userspace \
            -type f \
            -name 'NoMount-*.zip' \
            -print \
            -quit 2>/dev/null)" ]] || {
            echo "⛔ NoMount Userspace ZIP Missing"
            exit 1
          }
          [[ -n "$(find nomount-userspace \
            -type f \
            -name 'NoMount-*.zip.sha256' \
            -print \
            -quit 2>/dev/null)" ]] || {
            echo "⛔ NoMount Userspace SHA-256 Missing"
            exit 1
          }
        fi

        echo ""
        echo "✔️ Release Files Verified"

    - name: 📤 Create GitHub Release
      shell: bash
      env:
        GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        RELEASETAG: ${{ needs.kernel-build.outputs.manifestbasefile }}
        RELEASENAME: ${{ needs.kernel-build.outputs.manifestbasefile }}-${{ needs.kernel-build.outputs.kernelversion }}-${{ needs.kernel-build.outputs.suffix }}
      run: |
        set -Eeuo pipefail

        RELEASEBODY="${GITHUB_WORKSPACE}/release-body.md"

        # Generate Release Installation Instructions
        cat > "$RELEASEBODY" <<'EOF'
        ### 📋 **INSTALLATION GUIDE**

        ### 📩 **DOWNLOAD THE KERNEL ZIP FILE**
        ---
        - Navigate to the Release Page and Download the Correct Kernel ZIP File for Your Device and Kernel Version
        - Ensure that the Selected File Matches Your Device Model and Kernel Version

        ### 📲 **PREPARE YOUR DEVICE**
        ---
        - Make Sure Your Device Has an **Unlocked Bootloader** and a Compatible Custom Recovery
        - It is Recommended to Backup Your Data Before Installation

        ### 📤 **INSTALL THROUGH RECOVERY**
        ---
        - Reboot Your Device Into Recovery Mode
        - Select **Install** and Navigate to the Downloaded Kernel ZIP
        - Select the Kernel ZIP and Flash it
        - Reboot the Device After Flashing

        ### 📥 **INSTALLATION VIA KERNELFLASHER**
        ---
        - Install KernelFlasher
        - Launch KernelFlasher and Ensure Your Device is Rooted
        - Select the Downloaded Kernel ZIP
        - Follow the Flashing Instructions
        - Reboot After Flashing

        ### 📥 **INSTALLATION VIA HORIZON FLASHER**
        ---
        - Install Horizon Flasher
        - Select the Downloaded Kernel ZIP
        - Start the Flashing Process
        - Reboot After Flashing

        ### 🛠️ **TROUBLESHOOTING**
        ---
        - **Bootloops:** Revert to a Known-Good Kernel or Restore Your Backup
        - **Kernel Panic:** Verify that the Kernel Matches Your Device and Firmware
        - **Recovery Issues:** Reflash the Appropriate Recovery and Retry Installation

        ### 🧩 **ROOT ACCESS**
        ---
        - If Root Access is Required, Ensure the Corresponding Root Manager is Installed After Flashing

        ### 📊 **AFTER INSTALLATION**
        ---
        - Verify the Installed Kernel Version Using a Kernel Information or Kernel Checker Application
        - Verify Root Access if Applicable
        EOF

        # Start Release Asset List with Final AnyKernel3 ZIP
        RELEASEFILES=(
          "${ANYKERNEL3ZIP}"
        )

        # Add Every Generated Root Manager APK
        while IFS= read -r APK; do
          RELEASEFILES+=("$APK")
        done < <(
          find "${GITHUB_WORKSPACE}/Release-Output/manager" \
            -type f \
            -name '*.apk' \
            -print
        )

        # Add NoMount ZIP and Checksum When Enabled
        if [[ "${{ inputs.NOMOUNT }}" != "None" ]]; then
          while IFS= read -r NOMOUNTFILE; do
            RELEASEFILES+=("$NOMOUNTFILE")
          done < <(
            find "${GITHUB_WORKSPACE}/nomount-userspace" \
              -type f \
              \( \
                -name 'NoMount-*.zip' \
                -o \
                -name 'NoMount-*.zip.sha256' \
              \) \
              -print
          )
        fi

        # Display Complete Release Asset List
        echo "📦 Release Files:"
        printf '  %s\n' "${RELEASEFILES[@]}"
        echo ""

        # Verify Every Release Asset Exists and Contains Data
        for FILE in "${RELEASEFILES[@]}"; do
          [[ -f "$FILE" ]] || {
            echo "⛔ Release File Missing:"
            echo "   ${FILE}"
            exit 1
          }
          [[ -s "$FILE" ]] || {
            echo "⛔ Release File Is Empty:"
            echo "   ${FILE}"
            exit 1
          }
        done

        echo "✔️ Release Files Verified"
        echo ""

        # Create GitHub Release
        gh release create \
          "$RELEASETAG" \
          "${RELEASEFILES[@]}" \
          --repo "$GITHUB_REPOSITORY" \
          --title "$RELEASENAME" \
          --notes-file "$RELEASEBODY"
        echo "🎉 GitHub Release Created Successfully"
        echo "🏷️ Tag  : ${RELEASETAG}"
        echo "📋 Name : ${RELEASENAME}"
