# ==============================
# Release Cache Restoration
# ==============================
- name: 🔧 Release Cache Restoration
  if: ${{ env.BUILDCCACHE != 'Disabled' && steps.ccache-restore.outputs.cache-hit != 'true' }}      
  id: cache-restoration
  run: |
    echo "🚀 Cache Not Found Locally, Attempting to Restore from GitHub Release..."

    # Define the Release Asset
    TAR="CCache-${{ runner.os }}-${{ env.FILE_BASE }}-${{ env.CPUD }}-${{ github.ref_name }}.tar.zst"

    # Build the Download URL
    URL="https://github.com/AndreiMikh/CCache/releases/download/001/${TAR}"
    echo "📩 Downloading from: 🌐 $URL"

    # Ensure Cache Directory Exists and Fix Permissions
    mkdir -p "${{ env.CCACHE_DIR }}"  # Ensure the Directory is Created
    chmod -R 775 "${{ env.CCACHE_DIR }}"  # Ensure the Directory is Writable

    # Download Cache and Check if Found
    if ! curl -fsSL -o "$TAR" "$URL"; then
      echo "⚠️ Cache Not Found at $URL, Continuing Without Restoring..."
      echo "💡 Proceeding with a Full Build Without Cache..."
      echo "cache-restored=false" >> $GITHUB_ENV  # Set the output to false if cache isn't restored
    else
      echo "🔥 Cache Found, Extracting to ${{ env.CCACHE_DIR }}..."

      # Extract into Cache
      if [ -f "$TAR" ]; then
        tar -I zstd -xvf "$TAR" -C "${{ env.CCACHE_DIR }}"

        # Check if Extraction Was Successful
        if [ -d "${{ env.CCACHE_DIR }}" ] && [ "$(ls -A ${{ env.CCACHE_DIR }})" ]; then
          echo "👾 Cache Successfully Extracted..."
          ls -la "${{ env.CCACHE_DIR }}"
          echo "cache-restored=true" >> $GITHUB_ENV  # Set the output to true if cache is restored successfully
        else
          echo "⚠️ Compiler Cache Extraction Failed..."
          echo "cache-restored=false" >> $GITHUB_ENV  # Set the output to false if extraction failed
        fi
      else
        echo "⚠️ Compiler Cache File does Not Exist at $TAR."
        echo "cache-restored=false" >> $GITHUB_ENV  # Set the output to false if the cache file doesn't exist
      fi
    fi

  # Output success or failure
  outputs:
    cache-restored: ${{ steps.cache-restoration.outputs.cache-restored }}
