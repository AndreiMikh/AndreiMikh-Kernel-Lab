      - name: 🐳 LXC / Docker Auto Patch (Dynamic Fixed)
        if: ${{ github.event.inputs.LXCDOCKER == 'true' }}
        continue-on-error: true
        shell: bash
        run: |
          set -uo pipefail   # Unset Vars are Errors; Pipeline Fails if Any Step Fails
                             # No -e, so Script Continues on Patch Failures

          echo "------------------------------"
          echo "🚀 Starting Linux Container / Docker Patch Setup"
          echo "------------------------------"

          # ==============================
          # Clone Patch Repository (Branch 'NEW')
          # ==============================
          PATCH_REPO="https://github.com/AndreiMikh/GKI_KernelSU_SUSFS.git"
          PATCH_DIR_LOCAL="$GITHUB_WORKSPACE/lxc_repo"

          echo "📥 Cloning Patch Repository (Branch 'NEW')..."
          rm -rf "$PATCH_DIR_LOCAL" || true
          git clone --depth=1 -b new "$PATCH_REPO" "$PATCH_DIR_LOCAL" || echo "⚠️ Clone Failed, Continuing..."

          # ==============================
          # Navigate to Kernel Common Directory
          # ==============================
          KERNEL_COMMON_DIR="kernel_workspace/kernel_platform/common"
          if [ ! -d "$KERNEL_COMMON_DIR" ]; then
            echo "⚠️ Kernel Common Directory Not Found, Skipping Patch Step"
            exit 0
          fi
          cd "$KERNEL_COMMON_DIR"

          # ==============================
          # Detect Kernel Version
          # ==============================
          KERNEL_VERSION=$(make kernelversion 2>/dev/null || echo "6.6.0")
          echo "🧠 Using Kernel Version: $KERNEL_VERSION"

          KERNEL_MAJOR_MINOR=$(echo "$KERNEL_VERSION" | cut -d. -f1,2)
          echo "🧠 Kernel Base: $KERNEL_MAJOR_MINOR"

          # ==============================
          # Detect Android Version Safely
          # ==============================
          ANDROID_VER="${{ github.event.inputs.android_version:-}}"

          if [ -z "$ANDROID_VER" ]; then
            echo "⚠️ Android Version Input Empty → Using Android16"
            ANDROID_VER="android16"
          fi

          if [[ ! "$ANDROID_VER" =~ ^android[0-9]+$ ]]; then
            echo "⚠️ Invalid Android Version → Forcing Android16"
            ANDROID_VER="android16"
          fi

          ANDROID_NUM="${ANDROID_VER#android}"
          echo "📊 Android Version: $ANDROID_VER"

          # Export for Downstream Steps
          echo "ANDROID_VERSION=${ANDROID_NUM}.0.0" >> $GITHUB_ENV
          echo "ANDROID_SHORT_VERSION=${ANDROID_NUM}" >> $GITHUB_ENV
          echo "KANDROID_VERSION=android${ANDROID_NUM}" >> $GITHUB_ENV

          # ==============================
          # Determine Patch Directory (Smart Matching)
          # ==============================
          PATCH_BASE="$PATCH_DIR_LOCAL/lxc_docker_patches"

          # Gather All Candidate Patches for this Android Version
          CANDIDATES=$(find "$PATCH_BASE" -maxdepth 1 -type d -name "a${ANDROID_NUM}-*" | sort -V)

          TARGET_PATCH_DIR=""

          for dir in $CANDIDATES; do
            PATCH_KERNEL=$(basename "$dir" | cut -d- -f2)
            PATCH_MAJOR=$(echo "$PATCH_KERNEL" | cut -d. -f1)
            PATCH_MINOR=$(echo "$PATCH_KERNEL" | cut -d. -f2)
            KERN_MAJOR=$(echo "$KERNEL_MAJOR_MINOR" | cut -d. -f1)
            KERN_MINOR=$(echo "$KERNEL_MAJOR_MINOR" | cut -d. -f2)

            # Select Patch if Patch Kernel ≤ Current Kernel
            if (( PATCH_MAJOR < KERN_MAJOR )) || { (( PATCH_MAJOR == KERN_MAJOR )) && (( PATCH_MINOR <= KERN_MINOR )); }; then
              TARGET_PATCH_DIR="$dir"
            fi
          done

          # If no patch ≤ current kernel, pick the highest available as fallback
          if [ -z "$TARGET_PATCH_DIR" ] && [ -n "$CANDIDATES" ]; then
            TARGET_PATCH_DIR=$(echo "$CANDIDATES" | tail -n1)
          fi

          if [ -z "$TARGET_PATCH_DIR" ]; then
            echo "⚠️ No Compatible Patch Found for Android${ANDROID_NUM}-${KERNEL_MAJOR_MINOR}"
            exit 0
          fi

          echo "📂 Using Patch Directory: $TARGET_PATCH_DIR"

          # ==============================
          # Apply Patches
          # ==============================
          PATCHES_APPLIED=0
          PATCHES_SKIPPED=0
          PATCHES_FAILED=0

          for patch_file in "$TARGET_PATCH_DIR"/*.patch; do
            [ -f "$patch_file" ] || continue

            patch_name=$(basename "$patch_file")
            echo "➡️ Applying: $patch_name"

            # Skip if Already Applied
            if patch -R -p1 -s -f --dry-run < "$patch_file" >/dev/null 2>&1; then
              echo "⏭️ Already Applied → Skipping"
              PATCHES_SKIPPED=$((PATCHES_SKIPPED+1))
              continue
            fi

            # Apply Patch
            if patch -p1 -F3 --forward < "$patch_file"; then
              echo "✔️ Applied Successfully"
              PATCHES_APPLIED=$((PATCHES_APPLIED+1))
            else
              echo "⚠️ Patch Failed"
              PATCHES_FAILED=$((PATCHES_FAILED+1))
            fi
          done

          # ==============================
          # Patch Summary
          # ==============================
          echo "------------------------------"
          echo "Patch Summary"
          echo "------------------------------"
          echo "✔️ Applied : $PATCHES_APPLIED"
          echo "⚠️ Skipped : $PATCHES_SKIPPED"
          echo "🚩 Failed  : $PATCHES_FAILED"

          if [ "$PATCHES_FAILED" -gt 0 ]; then
            echo "⚠️ Some Patches Failed → Continuing build"
          else
            echo "🎉 LXC / Docker Patch Done"
          fi
